<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Mine.Wpf.Controls</RootNamespace>
        <AssemblyName>Mine.Wpf.Controls</AssemblyName>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <PackageId>Mine.Wpf.Controls</PackageId>
        <Version>0.1.1</Version>
        <Description>A Material Design 3 WPF control library with theming, animations and glass effects.</Description>
        <Authors>taigongzhaihua</Authors>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
        <PackageProjectUrl>https://github.com/taigongzhaihua/Mine.Wpf.Controls</PackageProjectUrl>
        <RepositoryUrl>https://github.com/taigongzhaihua/Mine.Wpf.Controls</RepositoryUrl>
        <PackageTags>wpf;material-design;md3;controls;ui</PackageTags>
        <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <UserSecretsId>9c48ac5e-70a1-4b65-8d5d-ed759ba676f7</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\LICENSE.txt" Pack="true" PackagePath="" />
        <None Include="..\README.md" Pack="true" PackagePath="" />
    </ItemGroup>

    <ItemGroup>
        <!-- Material Symbols 字体，嵌入为程序集资源 -->
        <Resource Include="Fonts\MaterialSymbols.ttf" />
        <Resource Include="Fonts\MaterialSymbolsFilled.ttf" />
        <!-- 拖拽手形光标（由 Tools/ConvertCursors.ps1 从 PNG 生成，随源码提交） -->
        <Resource Include="Assets\Cursors\grab.cur" />
        <Resource Include="Assets\Cursors\grabbing.cur" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Composition\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
    </ItemGroup>

</Project>
