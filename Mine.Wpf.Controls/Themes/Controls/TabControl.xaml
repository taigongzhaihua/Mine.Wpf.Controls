<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══════════════════════════════════════════════════════════
         TabItem — Material 3 风格
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TabItem}">
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="FontFamily"       Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"         Value="{DynamicResource Mine.FontSize.TitleSmall}"/>
        <Setter Property="FontWeight"       Value="Medium"/>
        <Setter Property="Padding"          Value="16,12"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" SnapsToDevicePixels="True">
                        <!-- Hover / press layer -->
                        <Border x:Name="HoverBg"
                                Background="{DynamicResource Mine.Brush.OnSurface}"
                                Opacity="0"
                                CornerRadius="4,4,0,0"/>

                        <!-- Label + icon -->
                        <Border Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <ContentPresenter x:Name="Icon"
                                                  ContentSource="Tag"
                                                  Margin="0,0,8,0"
                                                  VerticalAlignment="Center"
                                                  Visibility="Collapsed"/>
                                <ContentPresenter x:Name="Header"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"
                                                  TextBlock.FontWeight="{TemplateBinding FontWeight}"/>
                            </StackPanel>
                        </Border>

                        <!-- Active indicator -->
                        <Border x:Name="Indicator"
                                Height="3"
                                Background="{DynamicResource Mine.Brush.Primary}"
                                CornerRadius="3,3,0,0"
                                VerticalAlignment="Bottom"
                                Margin="12,0"
                                Opacity="0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.Primary}"/>
                            <Setter TargetName="Indicator" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HoverBg" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         TabControl — Material 3 风格 (Primary Tabs)
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type TabControl}">
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="Padding"          Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid KeyboardNavigation.TabNavigation="Local"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab header strip -->
                        <Border Grid.Row="0"
                                BorderBrush="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                BorderThickness="0,0,0,1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <TabPanel x:Name="HeaderPanel"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1"
                                          Background="Transparent"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Content area -->
                        <Border Grid.Row="1"
                                x:Name="ContentPanel"
                                Background="{TemplateBinding Background}"
                                KeyboardNavigation.TabNavigation="Local"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                KeyboardNavigation.TabIndex="2">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              ContentSource="SelectedContent"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════
         Secondary Tabs 变体（显示在内容区域内）
         ══════════════════════════════════════════════════════════ -->
    <Style x:Key="Mine.Style.TabControl.Secondary" TargetType="{x:Type TabControl}"
           BasedOn="{StaticResource {x:Type TabControl}}"/>

    <Style x:Key="Mine.Style.TabItem.Secondary" TargetType="{x:Type TabItem}"
           BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.LabelLarge}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,10"/>
    </Style>

</ResourceDictionary>

