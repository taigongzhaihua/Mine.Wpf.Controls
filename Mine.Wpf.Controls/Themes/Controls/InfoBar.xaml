<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">
    <!--
    ══════════════════════════════════════════════════════════════
     InfoBar — Material Design 3 内联信息提示条
     · 常驻于布局中，不自动消失、不悬浮
     · 支持 Info/Success/Warning/Error 四种语义色
    ══════════════════════════════════════════════════════════════
    -->

    <conv:NullToVisibilityConverter x:Key="InfoBar.NullToVis"/>
    <conv:BoolToVisibilityConverter x:Key="InfoBar.BoolToVis"/>

    <!-- ═══ InfoBar ═════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:InfoBar}">
        <Setter Property="Background"      Value="{DynamicResource Mine.Brush.InfoContainer}"/>
        <Setter Property="Foreground"      Value="{DynamicResource Mine.Brush.OnInfoContainer}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Visibility"      Value="Visible"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:InfoBar}">
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 图标 -->
                                <ColumnDefinition Width="*"/>     <!-- 标题 + 消息 + 内容 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 操作区 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 关闭按钮 -->
                            </Grid.ColumnDefinitions>

                            <!-- 级别图标 -->
                            <TextBlock x:Name="SeverityIcon"
                                       Grid.Column="0"
                                       FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Margin="0,1,10,0"
                                       Foreground="{TemplateBinding Foreground}"
                                       Text="&#xE88E;"/>

                            <!-- 标题 + 消息 + 自定义内容 -->
                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                                <ContentPresenter x:Name="TitlePresenter"
                                                  Content="{TemplateBinding Title}"
                                                  TextBlock.FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                                  TextBlock.FontSize="{DynamicResource Mine.FontSize.LabelLarge}"
                                                  TextBlock.FontWeight="SemiBold"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  Visibility="{TemplateBinding Title,
                                                      Converter={StaticResource InfoBar.NullToVis}}"/>
                                <ContentPresenter x:Name="MessagePresenter"
                                                  Content="{TemplateBinding Message}"
                                                  Margin="0,2,0,0"
                                                  TextBlock.FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                                  TextBlock.FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  Visibility="{TemplateBinding Message,
                                                      Converter={StaticResource InfoBar.NullToVis}}"/>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Margin="0,4,0,0"
                                                  TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  Visibility="{TemplateBinding Content,
                                                      Converter={StaticResource InfoBar.NullToVis}}"/>
                            </StackPanel>

                            <!-- 操作区 -->
                            <ContentPresenter x:Name="ActionPresenter"
                                              Grid.Column="2"
                                              Content="{TemplateBinding ActionContent}"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              Visibility="{TemplateBinding ActionContent,
                                                  Converter={StaticResource InfoBar.NullToVis}}"/>

                            <!-- 关闭按钮 -->
                            <controls:Button x:Name="PART_CloseButton"
                                             Grid.Column="3"
                                             Width="32" Height="32"
                                             Margin="8,-4,-4,0"
                                             VerticalAlignment="Top"
                                             Icon="&#xE5CD;"
                                             Foreground="{TemplateBinding Foreground}"
                                             Style="{DynamicResource Mine.Style.Button.Icon}"
                                             Visibility="{TemplateBinding IsClosable,
                                                 Converter={StaticResource InfoBar.BoolToVis}}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Success -->
                        <Trigger Property="Severity" Value="Success">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource Mine.Brush.SuccessContainer}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSuccessContainer}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE86C;"/>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="Severity" Value="Warning">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource Mine.Brush.WarningContainer}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnWarningContainer}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE002;"/>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="Severity" Value="Error">
                            <Setter TargetName="PART_Root" Property="Background" Value="{DynamicResource Mine.Brush.ErrorContainer}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnErrorContainer}"/>
                            <Setter TargetName="SeverityIcon" Property="Text" Value="&#xE000;"/>
                        </Trigger>
                        <!-- IsOpen = False → 折叠 -->
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
