<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mine="https://schemas.mine.io/wpf"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:attached="clr-namespace:Mine.Wpf.Controls.Attached">

    <Style TargetType="{x:Type controls:CarouselItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:CarouselItem}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding attached:ShapeAssist.CornerRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:Carousel}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="attached:ShapeAssist.CornerRadius" Value="{DynamicResource Mine.Shape.Large}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Carousel}">
                    <Grid x:Name="RootGrid">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding attached:ShapeAssist.CornerRadius}"
                                ClipToBounds="True">
                            <Grid>
                                <Grid.Resources>
                                    <controls:CarouselItemTransformConverter x:Key="CarouselItemTransformConverter"/>
                                    <controls:CarouselItemOpacityConverter x:Key="CarouselItemOpacityConverter"/>
                                    <controls:CarouselItemZIndexConverter x:Key="CarouselItemZIndexConverter"/>
                                    <controls:CarouselItemVisibilityConverter x:Key="CarouselItemVisibilityConverter"/>
                                </Grid.Resources>
                                <ItemsPresenter />
                            </Grid>
                        </Border>

                        <!-- Nav Buttons -->
                        <controls:Button x:Name="PART_PreviousButton"
                                         Variant="Text"
                                         Width="40" Height="40"
                                         MinWidth="40" MinHeight="40" MaxWidth="40" MaxHeight="40"
                                         CornerRadius="20"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="8,0" Padding="0"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Icon="&#xe5cb;"
                                         Command="{Binding PreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <controls:Button x:Name="PART_NextButton"
                                         Variant="Text"
                                         Width="40" Height="40"
                                         MinWidth="40" MinHeight="40" MaxWidth="40" MaxHeight="40"
                                         CornerRadius="20"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="8,0" Padding="0"
                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                         Icon="&#xe5cc;"
                                         Command="{Binding NextCommand, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <!-- Indicators (use ListBox so selection state is available) -->
                        <ListBox x:Name="PART_Indicators"
                                 ItemsSource="{Binding Items, RelativeSource={RelativeSource TemplatedParent}}"
                                 SelectedIndex="{Binding SelectedIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                 HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                 Margin="0,0,0,16"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="4"
                                                         Fill="{DynamicResource Mine.Brush.OnSurfaceVariant}" Opacity="0.5"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Mine.Brush.Primary}"/>
                                                        <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                                                        <Setter TargetName="Dot" Property="Width" Value="12"/>
                                                        <Setter TargetName="Dot" Property="Height" Value="12"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
