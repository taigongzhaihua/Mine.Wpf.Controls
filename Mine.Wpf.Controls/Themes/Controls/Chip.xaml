<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <!--
    ══════════════════════════════════════════════════════════════
     Chip — Material Design 3
     高度 32px，CornerRadius=8（Small），水平 Padding=16px
     4 种变体通过 DataTrigger(Variant) 切换外观：
       Assist     — 边框+背景透明，可选前置图标
       Filter     — 边框，选中时填充 SecondaryContainer + 勾选图标
       Input      — 边框，带前置图标/头像，带后置删除按钮
       Suggestion — 同 Assist，无图标
    ══════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type controls:Chip}">
        <Setter Property="Height"              Value="32"/>
        <Setter Property="Padding"             Value="16,0"/>
        <Setter Property="Cursor"              Value="Hand"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="FontFamily"          Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"            Value="{DynamicResource Mine.FontSize.LabelLarge}"/>
        <Setter Property="Foreground"          Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
        <Setter Property="Background"          Value="Transparent"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource Mine.Brush.Outline}"/>
        <Setter Property="BorderThickness"     Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Chip}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.15">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <VisualState x:Name="Normal"/>

                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckIcon"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckIcon"
                                                         Storyboard.TargetProperty="Width"
                                                         To="18" Duration="0"/>
                                    </Storyboard>
                                </VisualState>

                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Container"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.38" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Mine.Shape.Small}">

                            <!-- Chip 整体 Hover/Press 遮罩 -->
                            <Border x:Name="StateLayer"
                                    CornerRadius="{DynamicResource Mine.Shape.Small}"
                                    Background="Transparent">

                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="CheckCol"  Width="0"/>
                                        <ColumnDefinition x:Name="IconCol"   Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition x:Name="DeleteCol" Width="0"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Filter 勾选图标 -->
                                    <TextBlock x:Name="CheckIcon"
                                               Grid.Column="0"
                                               Width="0" Opacity="0"
                                               Text="&#xE5CA;"
                                               FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{DynamicResource Mine.Brush.OnSecondaryContainer}"
                                               Margin="0,0,4,0"
                                               IsHitTestVisible="False"/>

                                    <!-- 前置图标 -->
                                    <TextBlock x:Name="LeadingIcon"
                                               Grid.Column="1"
                                               Text="{TemplateBinding Icon}"
                                               FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                               FontSize="18"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}"
                                               Margin="0,0,8,0"
                                               Visibility="Collapsed"/>

                                    <!-- 标签 -->
                                    <ContentPresenter x:Name="Label"
                                                      Grid.Column="2"
                                                      Content="{TemplateBinding Content}"
                                                      VerticalAlignment="Center"
                                                      TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                      TextBlock.FontSize="{TemplateBinding FontSize}"
                                                      TextBlock.Foreground="{TemplateBinding Foreground}"/>

                                    <!-- Input 删除按钮 -->
                                    <Border x:Name="PART_DeleteButton"
                                            Grid.Column="3"
                                            Visibility="Collapsed"
                                            CornerRadius="10"
                                            Width="20" Height="20"
                                            Margin="4,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <!-- Background 放 Setter，不放本地值，否则 Trigger 优先级不够 -->
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.12"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="&#xE5CD;"
                                                   FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                                   FontSize="16"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                                   IsHitTestVisible="False"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Chip 整体 Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- Filter 选中态 -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Container" Property="Background"  Value="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground"                         Value="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
                        </Trigger>

                        <!-- Filter + Checked：展开 CheckIcon 列 -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant,   RelativeSource={RelativeSource Self}}" Value="Filter"/>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="CheckCol" Property="Width" Value="22"/>
                            <Setter Property="Padding" Value="8,0,16,0"/>
                        </MultiDataTrigger>

                        <!-- Input 变体 -->
                        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource Self}}" Value="Input">
                            <Setter TargetName="PART_DeleteButton" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="DeleteCol"         Property="Width"      Value="Auto"/>
                            <Setter Property="Padding" Value="12,0,8,0"/>
                                </DataTrigger>

                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- ── 专用子类样式（BasedOn 基类，仅预设 Variant）────────────── -->
                            <Style TargetType="{x:Type controls:AssistChip}"
                                   BasedOn="{StaticResource {x:Type controls:Chip}}">
                                <Setter Property="Variant" Value="Assist"/>
                            </Style>

                            <Style TargetType="{x:Type controls:FilterChip}"
                                   BasedOn="{StaticResource {x:Type controls:Chip}}">
                                <Setter Property="Variant" Value="Filter"/>
                            </Style>

                            <Style TargetType="{x:Type controls:InputChip}"
                                   BasedOn="{StaticResource {x:Type controls:Chip}}">
                                <Setter Property="Variant" Value="Input"/>
                            </Style>

                            <Style TargetType="{x:Type controls:SuggestionChip}"
                                   BasedOn="{StaticResource {x:Type controls:Chip}}">
                                <Setter Property="Variant" Value="Suggestion"/>
                            </Style>

                        </ResourceDictionary>









