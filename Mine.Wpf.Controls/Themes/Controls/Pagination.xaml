<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <!-- Local converter instance -->
    <conv:BoolToVisibilityConverter x:Key="Mine.Converter.BooleanToVisibility"/>

    <!--
    ══════════════════════════════════════════════════════════════
     PaginationControl — Material Design 3
     分页控件,支持页码跳转、上一页/下一页、首页/末页导航
     - 符合 MD3 设计规范
     - 使用项目内的 Mine Button 控件
     - 智能省略号显示
    ══════════════════════════════════════════════════════════════
    -->

    <!-- ═══════════════════════════════════════════════════════════
         PaginationControl 默认样式
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:PaginationControl}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PaginationControl}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="8">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <!-- 首页按钮 -->
                            <controls:Button x:Name="PART_FirstButton"
                                             Variant="Outlined"
                                             Width="40"
                                             Height="40"
                                             Padding="0"
                                             Margin="0,0,4,0"
                                             ToolTip="首页">
                                <controls:Button.Visibility>
                                    <Binding Path="ShowFirstLastButtons"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             Converter="{StaticResource Mine.Converter.BooleanToVisibility}"/>
                                </controls:Button.Visibility>
                                <controls:Button.Icon>
                                    <controls:MaterialIcon Kind="FirstPage" Size="20"/>
                                </controls:Button.Icon>
                            </controls:Button>

                            <!-- 上一页按钮 -->
                            <controls:Button x:Name="PART_PreviousButton"
                                             Variant="Outlined"
                                             Width="40"
                                             Height="40"
                                             Padding="0"
                                             Margin="0,0,4,0"
                                             ToolTip="上一页">
                                <controls:Button.Icon>
                                    <controls:MaterialIcon Kind="ChevronLeft" Size="20"/>
                                </controls:Button.Icon>
                            </controls:Button>

                            <!-- 页码按钮面板 -->
                            <StackPanel x:Name="PART_PageButtonsPanel"
                                        Orientation="Horizontal"
                                        Margin="4,0"/>

                            <!-- 下一页按钮 -->
                            <controls:Button x:Name="PART_NextButton"
                                             Variant="Outlined"
                                             Width="40"
                                             Height="40"
                                             Padding="0"
                                             Margin="4,0,0,0"
                                             ToolTip="下一页">
                                <controls:Button.Icon>
                                    <controls:MaterialIcon Kind="ChevronRight" Size="20"/>
                                </controls:Button.Icon>
                            </controls:Button>

                            <!-- 末页按钮 -->
                            <controls:Button x:Name="PART_LastButton"
                                             Variant="Outlined"
                                             Width="40"
                                             Height="40"
                                             Padding="0"
                                             Margin="4,0,0,0"
                                             ToolTip="末页">
                                <controls:Button.Visibility>
                                    <Binding Path="ShowFirstLastButtons"
                                             RelativeSource="{RelativeSource TemplatedParent}"
                                             Converter="{StaticResource Mine.Converter.BooleanToVisibility}"/>
                                </controls:Button.Visibility>
                                <controls:Button.Icon>
                                    <controls:MaterialIcon Kind="LastPage" Size="20"/>
                                </controls:Button.Icon>
                            </controls:Button>

                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
