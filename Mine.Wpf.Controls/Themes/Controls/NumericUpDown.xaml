<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters"
                    xmlns:primitives="clr-namespace:Mine.Wpf.Controls.Primitives">
    <conv:NullToVisibilityConverter x:Key="Local.NullToVisConv"/>
    <Style x:Key="Local.NumericUpDown.SpinButton" TargetType="RepeatButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.Primary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Local.NumericUpDown.SpinButton.Outlined"
           TargetType="RepeatButton"
           BasedOn="{StaticResource Local.NumericUpDown.SpinButton}">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <ControlTemplate x:Key="Mine.Template.NumericUpDown.Filled" TargetType="{x:Type controls:NumericUpDown}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4,4,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <TextBlock x:Name="HintLabel"
                               Text="{TemplateBinding Hint}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="12,6,0,0"
                               VerticalAlignment="Top"
                               Visibility="Collapsed"/>
                    <TextBox x:Name="PART_TextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{TemplateBinding Foreground}"
                             FontFamily="{TemplateBinding FontFamily}"
                             FontSize="{TemplateBinding FontSize}"
                             VerticalAlignment="Center"
                             Margin="12,0,4,0"
                             CaretBrush="{DynamicResource Mine.Brush.Primary}"
                             SelectionBrush="{DynamicResource Mine.Brush.Primary}"
                             FocusVisualStyle="{x:Null}"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,4">
                    <RepeatButton x:Name="PART_Increment"
                                  Style="{StaticResource Local.NumericUpDown.SpinButton}">
                        <TextBlock Text="&#xE5CE;"
                                   FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </RepeatButton>
                    <RepeatButton x:Name="PART_Decrement"
                                  Style="{StaticResource Local.NumericUpDown.SpinButton}">
                        <TextBlock Text="&#xE5CF;"
                                   FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </RepeatButton>
                </StackPanel>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Hint" Value="{x:Null}">
                <Setter TargetName="HintLabel" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <DataTrigger Binding="{Binding Hint, RelativeSource={RelativeSource Self}}" Value="">
                <Setter TargetName="HintLabel" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Hint, RelativeSource={RelativeSource Self}, Converter={StaticResource Local.NullToVisConv}}"
                         Value="Visible">
                <Setter TargetName="HintLabel" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PART_TextBox" Property="Margin" Value="12,16,4,-4"/>
            </DataTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Mine.Template.NumericUpDown.Outlined" TargetType="{x:Type controls:NumericUpDown}">
        <Grid>
            <Grid x:Name="InputRoot">
                <primitives:NotchedOutlineBorder x:Name="Container"
                                                BorderBrush="{DynamicResource Mine.Brush.Outline}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                NotchStart="12"
                                                NotchWidth="0"
                                                MinHeight="40">
                    <Grid Margin="12,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="PART_TextBox"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{TemplateBinding Foreground}"
                                 FontFamily="{TemplateBinding FontFamily}"
                                 FontSize="{TemplateBinding FontSize}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,4,0"
                                 CaretBrush="{DynamicResource Mine.Brush.Primary}"
                                 SelectionBrush="{DynamicResource Mine.Brush.Primary}"
                                 FocusVisualStyle="{x:Null}"/>

                        <StackPanel Grid.Column="1"
                                    Orientation="Vertical"
                                    Margin="4,4,0,4"
                                    HorizontalAlignment="Right">
                            <RepeatButton x:Name="PART_Increment"
                                          Style="{StaticResource Local.NumericUpDown.SpinButton.Outlined}">
                                <TextBlock Text="&#xE5CE;"
                                           FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </RepeatButton>
                            <RepeatButton x:Name="PART_Decrement"
                                          Style="{StaticResource Local.NumericUpDown.SpinButton.Outlined}">
                                <TextBlock Text="&#xE5CF;"
                                           FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </RepeatButton>
                        </StackPanel>
                    </Grid>
                </primitives:NotchedOutlineBorder>

                <TextBlock x:Name="PART_Hint"
                           Text="{TemplateBinding Hint}"
                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                           FontSize="{DynamicResource Mine.FontSize.BodyMedium}"
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                           IsHitTestVisible="False"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"
                           Margin="16,-7,0,0"
                           RenderTransformOrigin="0,0.5">
                    <TextBlock.RenderTransform>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </Grid>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Hint" Value="{x:Null}">
                <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <DataTrigger Binding="{Binding Hint, RelativeSource={RelativeSource Self}}" Value="">
                <Setter TargetName="PART_Hint" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource Mine.Brush.Primary}"/>
                <Setter TargetName="Container" Property="BorderThickness" Value="2"/>
                <Setter TargetName="PART_Hint" Property="Foreground" Value="{DynamicResource Mine.Brush.Primary}"/>
                <Setter TargetName="PART_Hint" Property="Margin" Value="16,-8,0,0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="InputRoot" Property="Opacity" Value="0.38"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type controls:NumericUpDown}">
        <Setter Property="Height" Value="56"/>
        <Setter Property="MinWidth" Value="120"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Mine.Brush.Outline}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.BodyLarge}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template" Value="{StaticResource Mine.Template.NumericUpDown.Filled}"/>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Outlined">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Template" Value="{StaticResource Mine.Template.NumericUpDown.Outlined}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>


