<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:attached="clr-namespace:Mine.Wpf.Controls.Attached"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">
    <!--
    ══════════════════════════════════════════════════════════════
     Toast / NotificationCenter — Material Design 3
     · Toast：右上角滑入的富文本通知卡片（Info/Success/Warning/Error）
     · NotificationCenter：铃铛按钮 + Popup 历史列表面板
    ══════════════════════════════════════════════════════════════
    -->

    <conv:BoolToVisibilityConverter     x:Key="Toast.BoolToVis"/>
    <conv:NullToVisibilityConverter     x:Key="Toast.NullToVis"/>
    <conv:ZeroToNullStringConverter     x:Key="Toast.BadgeTextConv"/>

    <!-- ═══ Toast ════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:Toast}">
        <Setter Property="Visibility"          Value="Collapsed"/>
        <Setter Property="Width"               Value="320"/>
        <Setter Property="Margin"              Value="0,0,0,8"/>
        <Setter Property="Focusable"           Value="False"/>
        <Setter Property="Panel.ZIndex"        Value="9999"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Toast}">
                    <Border x:Name="PART_Root"
                            Background="{DynamicResource Mine.Brush.SurfaceContainer}"
                            BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Mine.Shape.Medium}"
                            Padding="16,12"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0" Y="0"/>
                        </Border.RenderTransform>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4"
                                              Opacity="0.18" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>  <!-- 色条 + 图标 -->
                                <ColumnDefinition Width="*"/>     <!-- 标题 + 消息 -->
                                <ColumnDefinition Width="Auto"/>  <!-- 关闭按钮 -->
                            </Grid.ColumnDefinitions>

                            <!-- 级别图标 -->
                            <TextBlock x:Name="LevelIcon"
                                       Grid.Column="0"
                                       FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                       FontSize="20"
                                       VerticalAlignment="Top"
                                       Margin="0,1,10,0"
                                       Text="\uE88E"/>

                            <!-- 标题 + 消息 -->
                            <StackPanel Grid.Column="1" Orientation="Vertical">
                                <TextBlock Text="{TemplateBinding Title}"
                                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                           FontSize="{DynamicResource Mine.FontSize.LabelLarge}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Mine.Brush.OnSurface}"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="MessageText"
                                           Text="{TemplateBinding Content}"
                                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                           FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0"
                                           Visibility="{TemplateBinding Content,
                                               Converter={StaticResource Toast.NullToVis}}"/>
                            </StackPanel>

                            <!-- 关闭按钮 -->
                            <controls:Button x:Name="PART_Close"
                                             Grid.Column="2"
                                             Width="32" Height="32"
                                             Margin="8,-4,-4,0"
                                             VerticalAlignment="Top"
                                             Icon="&#xE5CD;"
                                             Style="{DynamicResource Mine.Style.Button.Icon}"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Info -->
                        <Trigger Property="Level" Value="Info">
                            <Setter TargetName="LevelIcon" Property="Text"       Value="&#xE88E;"/>
                            <Setter TargetName="LevelIcon" Property="Foreground"
                                    Value="{DynamicResource Mine.Brush.Primary}"/>
                        </Trigger>
                        <!-- Success -->
                        <Trigger Property="Level" Value="Success">
                            <Setter TargetName="LevelIcon" Property="Text"       Value="&#xE86C;"/>
                            <Setter TargetName="LevelIcon" Property="Foreground" Value="#4CAF50"/>
                        </Trigger>
                        <!-- Warning -->
                        <Trigger Property="Level" Value="Warning">
                            <Setter TargetName="LevelIcon" Property="Text"       Value="&#xE002;"/>
                            <Setter TargetName="LevelIcon" Property="Foreground" Value="#FF9800"/>
                        </Trigger>
                        <!-- Error -->
                        <Trigger Property="Level" Value="Error">
                            <Setter TargetName="LevelIcon" Property="Text"       Value="&#xE000;"/>
                            <Setter TargetName="LevelIcon" Property="Foreground"
                                    Value="{DynamicResource Mine.Brush.Error}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ NotificationCenter ══════════════════════════════════ -->
    <Style TargetType="{x:Type controls:NotificationCenter}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NotificationCenter}">
                    
                        <!-- 铃铛按钮 + Badge；Flyout 由代码后台在 Loaded 时挂载 -->
                        <controls:Badge BadgeText="{Binding UnreadCount,
                                           RelativeSource={RelativeSource TemplatedParent},
                                           Converter={StaticResource Toast.BadgeTextConv}}"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Width="40" Height="40">
                            <controls:Button x:Name="PART_Bell"
                                             Width="40" Height="40"
                                             Icon="&#xEA22;"
                                             Style="{DynamicResource Mine.Style.Button.Icon}"/>
                        </controls:Badge>
                   
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
