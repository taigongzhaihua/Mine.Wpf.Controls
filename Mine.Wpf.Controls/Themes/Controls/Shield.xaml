<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <!-- ═══════════════════════════════════════════════════════════
         Shield — M3 Style Badge (Like GitHub)
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:Shield}">
        <Setter Property="Background" Value="{DynamicResource Mine.Brush.Primary}"/>
        <Setter Property="LabelBackground" Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnPrimary}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Shield}">
                    <Border CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Height="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Label (Left side) -->
                            <Border Grid.Column="0"
                                    Background="{TemplateBinding LabelBackground}"
                                    Padding="8,0">
                                <TextBlock Text="{TemplateBinding Label}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True"/>
                            </Border>

                            <!-- Value (Right side) -->
                            <Border x:Name="PART_ValueBorder"
                                    Grid.Column="1"
                                    Background="{Binding Color, RelativeSource={RelativeSource TemplatedParent}}"
                                    Padding="8,0">
                                <TextBlock Text="{TemplateBinding Value}"
                                           Foreground="{TemplateBinding Foreground}"
                                           VerticalAlignment="Center"
                                           SnapsToDevicePixels="True"/>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Color" Value="{x:Null}">
                            <Setter TargetName="PART_ValueBorder" Property="Background" Value="{DynamicResource Mine.Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
