<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <!--
    ══════════════════════════════════════════════════════════════
     ImageViewer — Material Design 3
     图片查看器控件,支持缩放、拖拽、旋转
     - 符合 MD3 设计规范
     - 流畅的交互动画
     - 工具栏支持
     - 鼠标手势操作
    ══════════════════════════════════════════════════════════════
    -->

    <!-- ═══════════════════════════════════════════════════════════
         ImageViewer 默认样式
         ═══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:ImageViewer}">
        <Setter Property="Background"          Value="{DynamicResource Mine.Brush.Surface}"/>
        <Setter Property="Foreground"          Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource Mine.Brush.OutlineVariant}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="ClipToBounds"        Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:ImageViewer}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 图片容器 -->
                            <Border x:Name="PART_Container"
                                    Grid.Row="0"
                                    Background="{TemplateBinding Background}"
                                    ClipToBounds="True">
                                <Grid>
                                    <!-- 棋盘格背景（用于透明图片） -->
                                    <Rectangle x:Name="CheckerboardBackground"
                                               Opacity="0.1">
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile" 
                                                          Viewport="0,0,20,20" 
                                                          ViewportUnits="Absolute">
                                                <DrawingBrush.Drawing>
                                                    <DrawingGroup>
                                                        <GeometryDrawing Brush="{DynamicResource Mine.Brush.OnSurface}">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="0,0,10,10"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                        <GeometryDrawing Brush="{DynamicResource Mine.Brush.OnSurface}">
                                                            <GeometryDrawing.Geometry>
                                                                <RectangleGeometry Rect="10,10,10,10"/>
                                                            </GeometryDrawing.Geometry>
                                                        </GeometryDrawing>
                                                    </DrawingGroup>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <!-- 图片 -->
                                    <Image x:Name="PART_Image"
                                           Source="{TemplateBinding Source}"
                                           Stretch="None"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>

                            <!-- 工具栏 -->
                            <Border x:Name="PART_Toolbar"
                                    Grid.Row="1"
                                    Background="{DynamicResource Mine.Brush.SurfaceContainerHigh}"
                                    BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 左侧：缩放信息 -->
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Foreground="{TemplateBinding Foreground}"
                                                   VerticalAlignment="Center"
                                                   FontSize="14"
                                                   Margin="0,0,8,0">
                                            <TextBlock.Text>
                                                <Binding Path="Zoom" RelativeSource="{RelativeSource TemplatedParent}" StringFormat="{}{0:P0}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- 中间：操作按钮 -->
                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <!-- 放大 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding ZoomInCommand}"
                                                         ToolTip="放大 (滚轮向上)"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="ZoomIn" Size="20"/>
                                        </controls:Button>

                                        <!-- 缩小 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding ZoomOutCommand}"
                                                         ToolTip="缩小 (滚轮向下)"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="ZoomOut" Size="20"/>
                                        </controls:Button>

                                        <!-- 分隔线 -->
                                        <Rectangle Width="1"
                                                   Height="24"
                                                   Fill="{DynamicResource Mine.Brush.OutlineVariant}"
                                                   Margin="8,0"/>

                                        <!-- 左旋转 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding RotateLeftCommand}"
                                                         ToolTip="向左旋转 90°"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="RotateLeft" Size="20"/>
                                        </controls:Button>

                                        <!-- 右旋转 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding RotateRightCommand}"
                                                         ToolTip="向右旋转 90°"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="RotateRight" Size="20"/>
                                        </controls:Button>

                                        <!-- 分隔线 -->
                                        <Rectangle Width="1"
                                                   Height="24"
                                                   Fill="{DynamicResource Mine.Brush.OutlineVariant}"
                                                   Margin="8,0"/>

                                        <!-- 适应窗口 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding FitToWindowCommand}"
                                                         ToolTip="适应窗口"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="FitScreen" Size="20"/>
                                        </controls:Button>

                                        <!-- 重置 -->
                                        <controls:Button Variant="Text"
                                                         Command="{TemplateBinding ResetCommand}"
                                                         ToolTip="重置 (双击图片)"
                                                         Margin="2,0"
                                                         Padding="8"
                                                         Width="40"
                                                         Height="40">
                                            <controls:MaterialIcon Kind="RestartAlt" Size="20"/>
                                        </controls:Button>
                                    </StackPanel>

                                    <!-- 右侧：提示信息 -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center">
                                        <controls:MaterialIcon Kind="Info" 
                                                               Size="16" 
                                                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                                               Margin="0,0,6,0"
                                                               VerticalAlignment="Center"/>
                                        <TextBlock Text="拖拽平移 · 滚轮缩放 · 双击重置"
                                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 没有图片时隐藏棋盘格 -->
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="CheckerboardBackground" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="ShowToolbar" Value="False">
                            <Setter TargetName="PART_Toolbar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
