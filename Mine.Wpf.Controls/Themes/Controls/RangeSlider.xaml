<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">
    <Style x:Key="Mine.Style.RangeSlider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="44" Height="44" Background="Transparent">
                        <Ellipse x:Name="Halo"
                                 Width="40" Height="40"
                                 Fill="{DynamicResource Mine.Brush.Primary}"
                                 Opacity="0"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                        <Ellipse x:Name="Dot"
                                 Width="20" Height="20"
                                 Fill="{DynamicResource Mine.Brush.Primary}"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.16"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:RangeSlider}">
        <Setter Property="MinHeight" Value="96"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:RangeSlider}">
                    <Grid x:Name="PART_Root" VerticalAlignment="Center" ClipToBounds="False">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="52"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <Canvas Grid.Row="0"
                                IsHitTestVisible="False"
                                ClipToBounds="False">
                            <Border x:Name="PART_StartValueLabel"
                                    Background="{DynamicResource Mine.Brush.Primary}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    MinWidth="40"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="1">
                                <TextBlock Text="{TemplateBinding FormattedStart}"
                                           Foreground="{DynamicResource Mine.Brush.OnPrimary}"
                                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                           FontSize="{DynamicResource Mine.FontSize.LabelMedium}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                            <Border x:Name="PART_EndValueLabel"
                                    Background="{DynamicResource Mine.Brush.Primary}"
                                    CornerRadius="4"
                                    Padding="8,3"
                                    MinWidth="40"
                                    Visibility="Collapsed"
                                    Panel.ZIndex="1">
                                <TextBlock Text="{TemplateBinding FormattedEnd}"
                                           Foreground="{DynamicResource Mine.Brush.OnPrimary}"
                                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                           FontSize="{DynamicResource Mine.FontSize.LabelMedium}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </Border>
                        </Canvas>

                        <Grid Grid.Row="1" VerticalAlignment="Center" ClipToBounds="False">
                            <Grid x:Name="PART_Track"
                                  Margin="22,0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Stretch"
                                  Height="44"
                                  Background="Transparent">
                                <Canvas x:Name="PART_StopIndicatorsHost"
                                        Height="44"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"/>
                                <Border x:Name="PART_TrackLeft"
                                        Width="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="2,0,0,2"
                                        Background="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                                <Border x:Name="PART_Fill"
                                        Width="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="0"
                                        Background="{DynamicResource Mine.Brush.Primary}"/>
                                <Border x:Name="PART_TrackRight"
                                        Width="0"
                                        Height="4"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        CornerRadius="0,2,2,0"
                                        Background="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                            </Grid>
                            <Thumb x:Name="PART_ThumbStart"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Mine.Style.RangeSlider.Thumb}"/>
                            <Thumb x:Name="PART_ThumbEnd"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Mine.Style.RangeSlider.Thumb}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Root" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>

