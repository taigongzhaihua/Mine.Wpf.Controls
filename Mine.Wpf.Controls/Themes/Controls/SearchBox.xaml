<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <conv:RoundedRectClipConverter x:Key="Local.SearchBoxClipConv"/>

    <!-- ══════════════════════════════════════════════════════════════
         建议列表项样式（用 DynamicResource 引用避免 Storyboard 冻结崩溃）
         ══════════════════════════════════════════════════════════════ -->
    <Style x:Key="Mine.Style.SearchBox.SuggestionItem" TargetType="ListBoxItem">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="Foreground"        Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily"        Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"          Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
        <Setter Property="Padding"           Value="16,10"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Cursor"            Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Rectangle x:Name="StateLayer"
                                   Fill="{DynamicResource Mine.Brush.OnSurface}"
                                   Opacity="0"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.08" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="StateLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                            <Setter TargetName="StateLayer" Property="Fill"
                                    Value="{DynamicResource Mine.Brush.Primary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══════════════════════════════════════════════════════════════
         SearchBox — Bar 变体模板（胶囊型，带阴影，MD3 Search Bar）
         ══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="Mine.Template.SearchBox.Bar" TargetType="{x:Type controls:SearchBox}">
        <Grid Effect="{DynamicResource Mine.Elevation.1}" >
            <!-- 外层容器：胶囊圆角 + 阴影 -->
            <Border x:Name="Root"
                    Background="{DynamicResource Mine.Brush.SurfaceContainerHigh}"
                    CornerRadius="24"
                    MinHeight="48"
                    SnapsToDevicePixels="True">
                <Border.Clip>
                    <MultiBinding Converter="{StaticResource Local.SearchBoxClipConv}" ConverterParameter="24">
                        <Binding Path="ActualWidth"  RelativeSource="{RelativeSource Self}"/>
                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                    </MultiBinding>
                </Border.Clip>

                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 前置图标区（默认显示搜索图标，LeadingContent 有值时替换） -->
                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20">
                        <Grid>
                            <!-- 默认搜索图标（LeadingContent 为 null 时显示） -->
                            <controls:MaterialIcon x:Name="DefaultLeadingIcon"
                                                   Kind="Search" Size="20"
                                                   Foreground="{DynamicResource Mine.Brush.OnSurface}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                            <!-- 自定义前置内容 -->
                            <ContentPresenter x:Name="LeadingContent"
                                              Content="{TemplateBinding LeadingContent}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 输入区 + 占位符 -->
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Placeholder}"
                                   FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                   FontSize="{DynamicResource Mine.FontSize.BodyLarge}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 清空按钮（Border，非 Button，避免 TextBox 鼠标捕获冲突） -->
                    <Border x:Name="PART_ClearButton"
                            Grid.Column="2"
                            Width="36" Height="36"
                            CornerRadius="18"
                            Background="Transparent"
                            Cursor="Hand" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:MaterialIcon Kind="Clear" Size="18"
                                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                    </Border>

                    <!-- 右侧搜索按钮（Border，非 Button） -->
                    <Border x:Name="PART_SearchButton"
                            Grid.Column="3"
                            Width="40" Height="40"
                            CornerRadius="20"
                            Background="Transparent"
                            Cursor="Hand" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:MaterialIcon Kind="Search" Size="20"
                                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 建议列表 Popup -->
            <Popup x:Name="PART_SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=Root}"
                   Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" StaysOpen="False" Focusable="False"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Width="{Binding ActualWidth, ElementName=Root}">
                <Border Background="{DynamicResource Mine.Brush.SurfaceContainer}"
                        CornerRadius="12"
                        Effect="{DynamicResource Mine.Elevation.2}"
                        Padding="0,4">
                    <ListBox x:Name="PART_SuggestionsList"
                             ItemsSource="{Binding FilteredSuggestions, RelativeSource={RelativeSource TemplatedParent}}"
                             ItemContainerStyle="{DynamicResource Mine.Style.SearchBox.SuggestionItem}"
                             ItemTemplate="{Binding SuggestionItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                             DisplayMemberPath="{Binding SuggestionDisplayMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                             MaxHeight="320"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}" Focusable="False"/>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="HasText" Value="False">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClearable" Value="True"/>
                    <Condition Property="HasText"     Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="ShowSearchButton" Value="True">
                <Setter TargetName="PART_SearchButton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="LeadingContent" Value="{x:Null}">
                <Setter TargetName="DefaultLeadingIcon" Property="Visibility" Value="Visible"/>
                <Setter TargetName="LeadingContent"     Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Mine.Elevation.2}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══════════════════════════════════════════════════════════════
         SearchBox — Field 变体模板（边框型，紧凑嵌入式）
         ══════════════════════════════════════════════════════════════ -->
    <ControlTemplate x:Key="Mine.Template.SearchBox.Field" TargetType="{x:Type controls:SearchBox}">
        <Grid>
            <Border x:Name="Root"
                    Background="{DynamicResource Mine.Brush.SurfaceContainerHigh}"
                    BorderBrush="{DynamicResource Mine.Brush.Outline}"
                    BorderThickness="1"
                    CornerRadius="20"
                    MinHeight="40"
                    SnapsToDevicePixels="True">

                <Grid Margin="4,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 搜索图标 -->
                    <controls:MaterialIcon Grid.Column="0"
                                           Kind="Search" Size="16"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                           Margin="10,0,4,0" VerticalAlignment="Center"/>

                    <!-- 输入区 + 占位符 -->
                    <Grid Grid.Column="1">
                        <TextBlock x:Name="Placeholder"
                                   Text="{TemplateBinding Placeholder}"
                                   FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                   FontSize="{DynamicResource Mine.FontSize.BodyMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- 清空按钮（Border） -->
                    <Border x:Name="PART_ClearButton"
                            Grid.Column="2"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="Transparent"
                            Margin="2,0"
                            Cursor="Hand" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:MaterialIcon Kind="Clear" Size="14"
                                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                    </Border>

                    <!-- 右侧搜索按钮（Border，SecondaryContainer 色） -->
                    <Border x:Name="PART_SearchButton"
                            Grid.Column="3"
                            Width="30" Height="30"
                            CornerRadius="15"
                            Margin="2,0,2,0"
                            Background="{DynamicResource Mine.Brush.SecondaryContainer}"
                            Cursor="Hand" Visibility="Collapsed">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.88"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <controls:MaterialIcon Kind="Search" Size="15"
                                               Foreground="{DynamicResource Mine.Brush.OnSecondaryContainer}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 建议列表 Popup -->
            <Popup x:Name="PART_SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=Root}"
                   Placement="Bottom" VerticalOffset="4"
                   AllowsTransparency="True" StaysOpen="False" Focusable="False"
                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                   Width="{Binding ActualWidth, ElementName=Root}">
                <Border Background="{DynamicResource Mine.Brush.SurfaceContainer}"
                        CornerRadius="10"
                        Effect="{DynamicResource Mine.Elevation.2}"
                        Padding="0,4">
                    <ListBox x:Name="PART_SuggestionsList"
                             ItemsSource="{Binding FilteredSuggestions, RelativeSource={RelativeSource TemplatedParent}}"
                             ItemContainerStyle="{DynamicResource Mine.Style.SearchBox.SuggestionItem}"
                             ItemTemplate="{Binding SuggestionItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                             DisplayMemberPath="{Binding SuggestionDisplayMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                             MaxHeight="240"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}" Focusable="False"/>
                </Border>
            </Popup>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="HasText" Value="False">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsClearable" Value="True"/>
                    <Condition Property="HasText"     Value="True"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Visible"/>
            </MultiTrigger>
            <Trigger Property="ShowSearchButton" Value="True">
                <Setter TargetName="PART_SearchButton" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Root" Property="BorderBrush"     Value="{DynamicResource Mine.Brush.Primary}"/>
                <Setter TargetName="Root" Property="BorderThickness" Value="2"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ══════════════════════════════════════════════════════════════
         SearchBox — 默认样式
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:SearchBox}">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="Foreground"        Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="CaretBrush"        Value="{DynamicResource Mine.Brush.Primary}"/>
        <Setter Property="SelectionBrush"    Value="{DynamicResource Mine.Brush.PrimaryContainer}"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="FontFamily"        Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"          Value="{DynamicResource Mine.FontSize.BodyLarge}"/>
        <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
        <Setter Property="Padding"           Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template"          Value="{StaticResource Mine.Template.SearchBox.Bar}"/>

        <Style.Triggers>
            <Trigger Property="Variant" Value="Field">
                <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
                <Setter Property="Template" Value="{StaticResource Mine.Template.SearchBox.Field}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>


