<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:attached="clr-namespace:Mine.Wpf.Controls.Attached"
                    xmlns:mine="https://schemas.mine.io/wpf">

    <Style TargetType="{x:Type controls:FlipViewItem}">
        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainerLow}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FlipViewItem}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Mine.Shape.Medium}"
                            Effect="{DynamicResource Mine.Elevation.1}"
                            Padding="16">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:FlipView}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="mine:ShapeAssist.CornerRadius" Value="{DynamicResource Mine.Shape.Medium}"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <Grid/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="controls:FlipView.TransitionDuration" Value="0:0:0.32"/>
        <Setter Property="controls:FlipView.TransitionOffsetRatio" Value="0.6"/>
        <Setter Property="controls:FlipView.TransitionEasingMode" Value="EaseOut"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FlipView}">
                    <Grid>
                        <controls:Card Padding="0" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding mine:ShapeAssist.CornerRadius}" Effect="{DynamicResource Mine.Elevation.0}">
                            <Grid>
                                <ItemsPresenter KeyboardNavigation.IsTabStop="False" />
                            </Grid>
                        </controls:Card>

                        <controls:Button x:Name="PART_PreviousButton"
                                         Variant="Text"
                                         Width="40" Height="40"
                                         CornerRadius="20"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Margin="8,0"
                                         Icon="&#xe5cb;"
                                         Command="{Binding PreviousCommand, RelativeSource={RelativeSource TemplatedParent}}"/>

                        <controls:Button x:Name="PART_NextButton"
                                         Variant="Text"
                                         Width="40" Height="40"
                                         CornerRadius="20"
                                         HorizontalAlignment="Right" VerticalAlignment="Center"
                                         Margin="8,0"
                                         Icon="&#xe5cc;"
                                         Command="{Binding NextCommand, RelativeSource={RelativeSource TemplatedParent}}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
