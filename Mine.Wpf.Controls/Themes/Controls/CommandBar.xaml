<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mine.Wpf.Controls;component/Themes/Resources/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ══════════════════════════════════════════════════════════════
         CommandBar — Material Design 3 命令栏
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:CommandBar}">
        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SurfaceContainer}"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="OverflowButtonVisibility" Value="Auto"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:CommandBar}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Mine.Shape.Small}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <DockPanel LastChildFill="False">
                            <StackPanel x:Name="PART_PrimaryPanel"
                                        DockPanel.Dock="Left"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"/>

                            <c:AppBarButton x:Name="PART_OverflowButton"
                                            DockPanel.Dock="Right"
                                            Margin="4,0,0,0"
                                            IsCompact="True"
                                            Focusable="True">
                                <c:AppBarButton.Icon>
                                    <c:MaterialIcon Kind="MoreHoriz" Size="20"/>
                                </c:AppBarButton.Icon>
                            </c:AppBarButton>

                            <c:MenuFlyout x:Name="PART_OverflowMenu" Placement="Bottom"/>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppBarButton -->
    <Style TargetType="{x:Type c:AppBarButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.LabelSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AppBarButton}">
                    <Grid Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <Border x:Name="StateLayer"
                                Background="{DynamicResource Mine.Brush.OnSurface}"
                                CornerRadius="{DynamicResource Mine.Shape.Small}"
                                Opacity="0"/>

                        <StackPanel Margin="{TemplateBinding Padding}"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ContentPresenter x:Name="IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              Height="20"/>
                            <TextBlock x:Name="LabelText"
                                       Text="{TemplateBinding Label}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{TemplateBinding Label, Converter={StaticResource Mine.Internal.StringToVisConv}}"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppBarToggleButton -->
    <Style TargetType="{x:Type c:AppBarToggleButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.LabelSmall}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AppBarToggleButton}">
                    <Grid Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <Border x:Name="StateLayer"
                                Background="{DynamicResource Mine.Brush.OnSurface}"
                                CornerRadius="{DynamicResource Mine.Shape.Small}"
                                Opacity="0"/>
                        <Border x:Name="CheckedLayer"
                                Background="{DynamicResource Mine.Brush.SecondaryContainer}"
                                CornerRadius="{DynamicResource Mine.Shape.Small}"
                                Opacity="0"/>

                        <StackPanel Margin="{TemplateBinding Padding}"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <ContentPresenter x:Name="IconPresenter"
                                              Content="{TemplateBinding Icon}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Width="20"
                                              Height="20"/>
                            <TextBlock x:Name="LabelText"
                                       Text="{TemplateBinding Label}"
                                       Margin="0,4,0,0"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{TemplateBinding Label, Converter={StaticResource Mine.Internal.StringToVisConv}}"/>
                        </StackPanel>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckedLayer" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="LabelText" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- AppBarSeparator -->
    <Style TargetType="{x:Type c:AppBarSeparator}">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:AppBarSeparator}">
                    <Border Width="1"
                            Background="{DynamicResource Mine.Brush.OutlineVariant}"
                            HorizontalAlignment="Center"
                            Margin="4,0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
