<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <conv:RoundedRectClipConverter x:Key="Local.FlyoutClipConv"/>

    <!-- ══════════════════════════════════════════════════════════════
         Flyout — Material Design 3
         点击触发的轻量弹出层，支持任意内容、淡入+缩放动画、light-dismiss。
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:Flyout}">
        <Setter Property="Background"     Value="{DynamicResource Mine.Brush.SurfaceContainerLow}"/>
        <Setter Property="Foreground"     Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily"     Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"       Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
        <Setter Property="Padding"        Value="0"/>
        <Setter Property="MinWidth"       Value="120"/>
        <Setter Property="MaxWidth"       Value="320"/>
        <Setter Property="VerticalOffset" Value="4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <!-- 根节点：零尺寸 Grid，Flyout 本身不占布局空间 -->
                <ControlTemplate TargetType="{x:Type controls:Flyout}">
                    <Grid Width="0" Height="0" IsHitTestVisible="False">
                        <Popup x:Name="PART_Popup"
                               AllowsTransparency="True"
                               Placement="{TemplateBinding Placement}"
                               PlacementTarget="{TemplateBinding PlacementTarget}"
                               HorizontalOffset="{TemplateBinding HorizontalOffset}"
                               VerticalOffset="{TemplateBinding VerticalOffset}"
                               StaysOpen="False"
                               SnapsToDevicePixels="True">
                            <!-- PART_Container: 实际可见容器，动画作用于此元素 -->
                            <Grid Margin="16">
                                <Grid.Effect>
                                    <DropShadowEffect BlurRadius="16"
                                                      ShadowDepth="4"
                                                      Opacity="0.28"
                                                      Direction="270" />
                                </Grid.Effect>
                                <Border x:Name="PART_Container"
                                        Background="{TemplateBinding Background}"
                                         BorderBrush="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Mine.Shape.Medium}"
                                        MinWidth="{TemplateBinding MinWidth}"
                                        MaxWidth="{TemplateBinding MaxWidth}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <Border.Clip>
                                        <MultiBinding Converter="{StaticResource Local.FlyoutClipConv}">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                            <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                                        </MultiBinding>
                                    </Border.Clip>
                                <ContentPresenter TextBlock.Foreground="{TemplateBinding Foreground}"
                                                  TextBlock.FontFamily="{TemplateBinding FontFamily}"
                                                  TextBlock.FontSize="{TemplateBinding FontSize}"/>
                            </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

