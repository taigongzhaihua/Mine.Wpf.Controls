<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">
    <!--
    ══════════════════════════════════════════════════════════════
     Avatar — Material Design 3
     圆形头像，内容优先级：Image > Icon > Initials > 默认人形图标
     使用 Border(CornerRadius=9999, ClipToBounds=True) 实现圆形裁剪
    ══════════════════════════════════════════════════════════════
    -->
    <conv:HalfValueConverter x:Key="Local.HalfConv"/>
    <conv:RoundedRectClipConverter x:Key="Local.AvatarClipConv"/>

    <Style TargetType="{x:Type controls:Avatar}">
        <Setter Property="Width"     Value="{Binding Size, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Height"    Value="{Binding Size, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Mine.Brush.SecondaryContainer}"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Avatar}">
                    <!-- 外描边环：用于 AvatarGroup 中分隔重叠头像 -->
                    <Border x:Name="BorderRing"
                            Width="{TemplateBinding Width}"
                            Height="{TemplateBinding Height}"
                            CornerRadius="9999"
                            Background="{TemplateBinding BorderBrush}"
                            Padding="{TemplateBinding BorderThickness}">
                        <Border x:Name="Root"
                                CornerRadius="9999"
                                ClipToBounds="True"
                                Background="{TemplateBinding Background}">
                            <Border.Clip>
                                <MultiBinding Converter="{StaticResource Local.AvatarClipConv}">
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Border.Clip>
                            <Grid>
                                <Image x:Name="PART_Image"
                                       Source="{TemplateBinding ImageSource}"
                                       Stretch="UniformToFill"
                                       Visibility="Collapsed"/>
                                <TextBlock x:Name="PART_IconText"
                                           Text="{TemplateBinding Icon}"
                                           FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                           FontSize="{Binding Size, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource Local.HalfConv}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           Visibility="Collapsed"/>
                                <!-- 默认：人形图标；Initials 变体时切换为文字 -->
                                <TextBlock x:Name="PART_Initials"
                                           Text="&#xE7FD;"
                                           FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                           FontSize="{Binding Size, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource Local.HalfConv}}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="AvatarVariant" Value="Image">
                            <Setter TargetName="PART_Image"    Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Initials" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="AvatarVariant" Value="Icon">
                            <Setter TargetName="PART_IconText" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="PART_Initials" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="AvatarVariant" Value="Initials">
                            <Setter TargetName="PART_Initials" Property="Text"
                                    Value="{Binding Initials, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_Initials" Property="FontFamily"
                                    Value="{DynamicResource Mine.FontFamily.Default}"/>
                            <Setter TargetName="PART_Initials" Property="FontWeight" Value="Medium"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
    ══════════════════════════════════════════════════════════════
     AvatarGroup — 水平重叠头像组
     · AvatarGroupPanel 负责重叠 Arrange
     · PART_Overflow 显示 "+N" 溢出气泡
    ══════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type controls:AvatarGroup}">
        <Setter Property="Focusable"  Value="False"/>
        <Setter Property="AvatarSize" Value="40"/>
        <Setter Property="Spacing"    Value="-8"/>
        <Setter Property="AvatarBorderBrush"
                Value="{DynamicResource Mine.Brush.SurfaceContainerLow}"/>
        <Setter Property="AvatarBorderThickness" Value="3"/>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <controls:AvatarGroupPanel
                        Spacing="{Binding Spacing, RelativeSource={RelativeSource AncestorType=controls:AvatarGroup}}"/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AvatarGroup}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ItemsPresenter/>
                        <!-- "+N" 溢出气泡，与其他头像相同重叠间距 -->
                        <Border x:Name="PART_Overflow"
                                Visibility="Collapsed"
                                Width="{TemplateBinding AvatarSize}"
                                Height="{TemplateBinding AvatarSize}"
                                CornerRadius="9999"
                                Background="{TemplateBinding AvatarBorderBrush}">
                            <Border CornerRadius="9999"
                                    ClipToBounds="True"
                                    Background="{DynamicResource Mine.Brush.SecondaryContainer}"
                                    Margin="3">
                                <TextBlock Text="{TemplateBinding OverflowText}"
                                           FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                           FontSize="{Binding AvatarSize, RelativeSource={RelativeSource TemplatedParent},
                                                      Converter={StaticResource Local.HalfConv}}"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource Mine.Brush.OnSecondaryContainer}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
