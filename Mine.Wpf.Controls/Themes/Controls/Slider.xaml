<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <!-- ═══════════════════════════════════════════════════════════
         Slider — Material Design 3
         结构：DecreaseRepeatButton = 已填充轨道（Primary）
                IncreaseRepeatButton = 未填充轨道（SecondaryContainer）
                Thumb = 圆形滑块，自带 Hover/IsDragging Triggers
         ═══════════════════════════════════════════════════════════ -->

    <!-- 已填充段 -->
    <Style x:Key="Mine.Style.Slider.RepeatButton.Fill" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4"
                            CornerRadius="2,0,0,2"
                            Background="{DynamicResource Mine.Brush.Primary}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 未填充段 -->
    <Style x:Key="Mine.Style.Slider.RepeatButton.Track" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="IsTabStop"             Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="4"
                            CornerRadius="0,2,2,0"
                            Background="{DynamicResource Mine.Brush.SecondaryContainer}"
                            VerticalAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thumb -->
    <Style x:Key="Mine.Style.Slider.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable"             Value="False"/>
        <Setter Property="Width"                 Value="44"/>
        <Setter Property="Height"                Value="44"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Width="44" Height="44" Background="Transparent">
                        <!-- 光晕 40×40，居中，完全在 44px 边界内 -->
                        <Ellipse x:Name="Halo"
                                 Width="40" Height="40"
                                 Fill="{DynamicResource Mine.Brush.Primary}"
                                 Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <!-- 圆点 -->
                        <Ellipse x:Name="Dot"
                                 Width="20" Height="20"
                                 Fill="{DynamicResource Mine.Brush.Primary}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.16"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── 主样式 ─────────────────────────────────────────────── -->
    <Style TargetType="{x:Type controls:Slider}">
        <Setter Property="Minimum"          Value="0"/>
        <Setter Property="Maximum"          Value="100"/>
        <Setter Property="Value"            Value="0"/>
        <Setter Property="FontFamily"       Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"         Value="{DynamicResource Mine.FontSize.LabelMedium}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.Primary}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="MinWidth"         Value="80"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Slider}">
                    <Grid x:Name="Root" ClipToBounds="False">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver"/>
                                <VisualState x:Name="Pressed"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.38" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="44"/>
                        </Grid.RowDefinitions>

                        <!-- 值气泡（ShowValueLabel=True 时可见，拖动时由 Thumb IsDragging 驱动显示） -->
                        <Border x:Name="ValueLabel"
                                Grid.Row="0"
                                Background="{DynamicResource Mine.Brush.Primary}"
                                CornerRadius="4"
                                Padding="8,3"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,4"
                                Visibility="Collapsed">
                            <TextBlock Text="{Binding FormattedValue, RelativeSource={RelativeSource AncestorType=controls:Slider}}"
                                       Foreground="{DynamicResource Mine.Brush.OnPrimary}"
                                       FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                       FontSize="{DynamicResource Mine.FontSize.LabelMedium}"/>
                        </Border>

                        <!-- Track：左右各留 22px（Thumb 半���），避免端点时 Thumb 被父容器裁剪 -->
                        <Track x:Name="PART_Track" Grid.Row="1" Margin="22,0" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mine.Style.Slider.RepeatButton.Fill}"
                                              Command="Slider.DecreaseLarge"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Mine.Style.Slider.RepeatButton.Track}"
                                              Command="Slider.IncreaseLarge"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Mine.Style.Slider.Thumb}"/>
                            </Track.Thumb>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowValueLabel" Value="True">
                            <Setter TargetName="ValueLabel" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


