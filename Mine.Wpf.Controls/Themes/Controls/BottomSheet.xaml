<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">
    <!--
    ══════════════════════════════════════════════════════════════
     BottomSheet — Material Design 3 Bottom Sheet
     模板结构：
       Grid（填满父容器，ClipToBounds）
       ├─ ContentPresenter              ← 主体内容（始终可见）
       ├─ Border PART_Scrim             ← 半透明遮罩（Modal 变体，Opacity 动画）
       └─ Border PART_SheetPanel        ← 面板（TranslateTransform Y 轴动画）
            ├─ Border   DragHandle      ← 顶部拖拽手柄（可隐藏）
            └─ ContentPresenter         ← SheetContent
     IsOpen/Variant 由 BottomSheet.cs 代码驱动动画，模板只提供结构。
    ══════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type controls:BottomSheet}">
        <Setter Property="Focusable"                  Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BottomSheet}">
                    <Grid ClipToBounds="True">

                        <!-- 主体内容 -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <!-- 遮罩层（Modal 变体使用）。Opacity 由代码驱动，初始 Collapsed -->
                        <Border x:Name="PART_Scrim"
                                Background="{DynamicResource Mine.Brush.Scrim}"
                                Opacity="0"
                                Visibility="Collapsed"/>

                        <!-- 面板：底部对齐，TranslateTransform 由代码驱动 -->
                        <Border x:Name="PART_SheetPanel"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Height="{TemplateBinding SheetHeight}"
                                MaxHeight="{TemplateBinding MaxSheetHeight}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="{DynamicResource Mine.Brush.SurfaceContainerLow}"
                                Visibility="Collapsed">
                            <Border.RenderTransform>
                                <TranslateTransform/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="32" ShadowDepth="0"
                                                  Opacity="0.25"
                                                  Color="{DynamicResource Mine.Color.Shadow}"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- 拖拽手柄 -->
                                <Border x:Name="PART_DragHandle"
                                        Grid.Row="0"
                                        Height="32"
                                        Background="Transparent">
                                    <Border x:Name="DragHandleIndicator"
                                            Width="32" Height="4"
                                            CornerRadius="2"
                                            Background="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                            Opacity="0.38"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="1" ScaleY="1"
                                                            CenterX="16" CenterY="2"/>
                                        </Border.RenderTransform>
                                    </Border>
                                </Border>

                                <!-- 面板内容 -->
                                <ContentPresenter Grid.Row="1"
                                                  Content="{TemplateBinding SheetContent}"
                                                  ContentTemplate="{TemplateBinding SheetContentTemplate}"/>
                            </Grid>
                        </Border>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- 拖拽手柄悬停变亮 -->
                        <Trigger SourceName="PART_DragHandle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="DragHandleIndicator" Property="Opacity" Value="0.72"/>
                            <Setter TargetName="DragHandleIndicator" Property="Width"   Value="36"/>
                        </Trigger>
                        <!-- 隐藏拖拽手柄 -->
                        <Trigger Property="ShowDragHandle" Value="False">
                            <Setter TargetName="PART_DragHandle" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Standard 变体：遮罩始终不显示 -->
                        <Trigger Property="Variant" Value="Standard">
                            <Setter TargetName="PART_Scrim" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
