<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mine.Wpf.Controls;component/Themes/Resources/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Local converter instance — unique key to avoid duplicate -->
    <conv:BoolToVisibilityConverter x:Key="Snackbar.BoolToVis"/>
    <conv:NullToVisibilityConverter x:Key="Snackbar.NullToVis"/>

    <!-- ══════════════════════════════════════════════════════════
         Snackbar — Material 3 风格
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:Snackbar}">
        <Setter Property="Visibility"           Value="Collapsed"/>
        <Setter Property="HorizontalAlignment"  Value="Center"/>
        <Setter Property="VerticalAlignment"    Value="Bottom"/>
        <Setter Property="Margin"               Value="0,0,0,24"/>
        <Setter Property="MaxWidth"             Value="600"/>
        <Setter Property="MinWidth"             Value="288"/>
        <Setter Property="Focusable"            Value="False"/>
        <Setter Property="Panel.ZIndex"         Value="9999"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Snackbar}">
                    <Border x:Name="PART_Root"
                            Background="{DynamicResource Mine.Brush.InverseSurface}"
                            CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                            Padding="16,0"
                            MinHeight="48"
                            MaxWidth="{TemplateBinding MaxWidth}"
                            MinWidth="{TemplateBinding MinWidth}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="4"
                                              Opacity="0.3" Direction="270"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Message text -->
                            <TextBlock Grid.Column="0"
                                       Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource Mine.Brush.InverseOnSurface}"
                                       FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                       FontSize="{DynamicResource Mine.FontSize.BodyMedium}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,12"/>

                            <!-- Action button -->
                            <Button x:Name="PART_ActionButton"
                                    Grid.Column="1"
                                    Content="{TemplateBinding ActionLabel}"
                                    Foreground="{DynamicResource Mine.Brush.InversePrimary}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                    FontSize="{DynamicResource Mine.FontSize.LabelLarge}"
                                    FontWeight="Medium"
                                    Padding="12,0"
                                    Height="36"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Margin="8,0,0,0"
                                    Visibility="{TemplateBinding HasAction,
                                        Converter={StaticResource Snackbar.BoolToVis}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg"
                                                Background="{DynamicResource Mine.Brush.InversePrimary}"
                                                CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                                Padding="{TemplateBinding Padding}"
                                                Opacity="0">
                                            <TextBlock Text="{TemplateBinding Content}"
                                                       Foreground="{TemplateBinding Foreground}"
                                                       FontFamily="{TemplateBinding FontFamily}"
                                                       FontSize="{TemplateBinding FontSize}"
                                                       FontWeight="{TemplateBinding FontWeight}"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.12"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Bg" Property="Opacity" Value="0.24"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Close button — Border + MouseLeftButtonDown 确保可靠命中测试 -->
                            <Border x:Name="PART_CloseButton"
                                    Grid.Column="2"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="Transparent"
                                    Cursor="Hand"
                                    Margin="4,0,-4,0"
                                    ToolTip="关闭">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <SolidColorBrush Color="{DynamicResource Mine.Color.InverseOnSurface}" Opacity="0.12"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <controls:MaterialIcon Kind="&#xE5CD;" Size="18"
                                                       Foreground="{DynamicResource Mine.Brush.InverseOnSurface}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                            </Border>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

