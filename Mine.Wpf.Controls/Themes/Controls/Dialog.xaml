<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:primitives="clr-namespace:Mine.Wpf.Controls.Primitives"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Mine.Wpf.Controls;component/Themes/Resources/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Local converter instances (avoid duplicate key) -->
    <conv:BoolToVisibilityConverter  x:Key="Dialog.BoolToVis"/>
    <conv:NullToVisibilityConverter  x:Key="Dialog.NullToVis"/>

    <!-- ══════════════════════════════════════════════════════════
         DialogHost — Material 3 Basic Dialog
         ══════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:DialogHost}">
        <Setter Property="Visibility"           Value="Collapsed"/>
        <Setter Property="HorizontalAlignment"  Value="Stretch"/>
        <Setter Property="VerticalAlignment"    Value="Stretch"/>
        <Setter Property="Panel.ZIndex"         Value="9998"/>
        <Setter Property="Focusable"            Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:DialogHost}">
                    <Grid>
                        <!-- Scrim（亚克力：模糊截图 + 半透明色调叠加） -->
                        <Border x:Name="PART_Scrim"
                                Background="Transparent"
                                Opacity="0">
                            <Grid>
                                <!-- 截图模糊层 -->
                                <Image x:Name="PART_ScrimImage" Stretch="Fill">
                                    <Image.Effect>
                                        <BlurEffect Radius="24" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>
                                <!-- 半透明色调叠加 -->
                                <Border Background="#000000"
                                        Opacity="0.85"/>
                            </Grid>
                        </Border>

                        <!-- Dialog container -->
                        <Border x:Name="PART_Container"
                                Background="{DynamicResource Mine.Brush.SurfaceContainerHigh}"
                                CornerRadius="{DynamicResource Mine.Shape.ExtraLarge}"
                                Padding="24"
                                MinWidth="280"
                                MaxWidth="560"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="6"
                                                  Opacity="0.25" Direction="270"/>
                            </Border.Effect>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>

                            <StackPanel>
                                <!-- Title -->
                                <TextBlock x:Name="TitleBlock"
                                           Text="{TemplateBinding Title}"
                                           Style="{DynamicResource Mine.Typography.HeadlineSmall}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurface}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,16"
                                           Visibility="{TemplateBinding Title,
                                               Converter={StaticResource Dialog.NullToVis}}"/>

                                <!-- Content -->
                                <ContentPresenter Margin="0,0,0,24"
                                                  TextBlock.FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                                  TextBlock.FontSize="{DynamicResource Mine.FontSize.BodyMedium}"
                                                  TextBlock.Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>

                                <!-- Buttons -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <!-- Cancel — Text style inline -->
                                    <controls:Button x:Name="PART_Cancel"
                                                     Content="{TemplateBinding CancelText}"
                                                     Background="Transparent"
                                                     Foreground="{DynamicResource Mine.Brush.Primary}"
                                                     BorderThickness="0"
                                                     Padding="12,10"
                                                     Margin="0,0,8,0"
                                                     Visibility="{TemplateBinding HasCancel,
                                                         Converter={StaticResource Dialog.BoolToVis}}"/>
                                    <!-- Confirm — Filled style inline -->
                                    <controls:Button x:Name="PART_Confirm"
                                                     Content="{TemplateBinding ConfirmText}"
                                                     Background="{DynamicResource Mine.Brush.Primary}"
                                                     Foreground="{DynamicResource Mine.Brush.OnPrimary}"
                                                     BorderThickness="0"
                                                     Padding="24,10"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

