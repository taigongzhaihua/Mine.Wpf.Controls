<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mine.Wpf.Controls;component/Themes/Resources/Converters.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <conv:RoundedRectClipConverter x:Key="Local.MenuFlyoutClipConv"/>

    <!-- ══════════════════════════════════════════════════════════════
         MenuFlyout — Material Design 3 菜单
         ══════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:MenuFlyout}">
        <Setter Property="MenuMinWidth" Value="112"/>
        <Setter Property="MenuMaxWidth" Value="280"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyout}">
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           StaysOpen="{TemplateBinding StaysOpen}"
                           PopupAnimation="None"
                           Placement="{TemplateBinding Placement}"
                           PlacementTarget="{TemplateBinding PlacementTarget}"
                           VerticalOffset="4">
                        <Grid Margin="16">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.30" Direction="270"/>
                            </Grid.Effect>
                            <Border x:Name="PART_Container"
                                    Background="{DynamicResource Mine.Brush.SurfaceContainerLow}"
                                    BorderBrush="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                    MinWidth="{TemplateBinding MenuMinWidth}"
                                    MaxWidth="{TemplateBinding MenuMaxWidth}"
                                    Padding="0,8"
                                    Focusable="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle"
                                    SnapsToDevicePixels="True">
                                <Border.Clip>
                                    <MultiBinding Converter="{StaticResource Local.MenuFlyoutClipConv}">
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                        <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                                    </MultiBinding>
                                </Border.Clip>
                                <StackPanel x:Name="PART_ItemsPanel" />
                            </Border>
                        </Grid>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuFlyoutItem -->
    <Style TargetType="{x:Type c:MenuFlyoutItem}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.BodyLarge}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutItem}">
                    <Grid x:Name="Border"
                          Background="{TemplateBinding Background}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True">
                        <!-- 状态层：独立叠加，不影响内容不透明度 -->
                        <Border x:Name="StateLayer"
                                Background="{DynamicResource Mine.Brush.OnSurface}"
                                CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                Opacity="0"/>

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Width="20"
                                              Height="20"
                                              Visibility="{TemplateBinding Icon, Converter={StaticResource Mine.Internal.NullToVisConv}}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Text}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <TextBlock x:Name="AcceleratorText"
                                       Grid.Column="2"
                                       Text="{TemplateBinding InputGestureText}"
                                       Margin="24,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Opacity="0.6"
                                       Visibility="{TemplateBinding InputGestureText, Converter={StaticResource Mine.Internal.StringToVisConv}}"/>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuFlyoutSeparator -->
    <Style TargetType="{x:Type c:MenuFlyoutSeparator}">
        <Setter Property="Height" Value="9"/>
        <Setter Property="Margin" Value="12,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutSeparator}">
                    <Border Height="1"
                            Background="{DynamicResource Mine.Brush.OutlineVariant}"
                            VerticalAlignment="Center"
                            Margin="0,4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- MenuFlyoutSubItem -->
    <Style TargetType="{x:Type c:MenuFlyoutSubItem}">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="Margin" Value="4,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize" Value="{DynamicResource Mine.FontSize.BodyLarge}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutSubItem}">
                    <Grid x:Name="Border"
                          Background="{TemplateBinding Background}"
                          Height="{TemplateBinding Height}"
                          SnapsToDevicePixels="True">
                        <!-- 状态层：独立叠加，不影响内容不透明度 -->
                        <Border x:Name="StateLayer"
                                Background="{DynamicResource Mine.Brush.OnSurface}"
                                CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                Opacity="0"/>

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="IconPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding Icon}"
                                              Margin="0,0,12,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Width="20"
                                              Height="20"
                                              Visibility="{TemplateBinding Icon, Converter={StaticResource Mine.Internal.NullToVisConv}}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Text}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>

                            <c:MaterialIcon Grid.Column="2"
                                            Kind="ChevronRight"
                                            Size="18"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"/>

                            <Popup x:Name="PART_SubMenuPopup"
                                   AllowsTransparency="True"
                                   StaysOpen="True"
                                   Placement="Right"
                                   HorizontalOffset="4"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   IsOpen="{TemplateBinding IsSubMenuOpen}">
                                <Grid Margin="16">
                                    <Grid.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.30" Direction="270"/>
                                    </Grid.Effect>
                                    <Border Background="{DynamicResource Mine.Brush.SurfaceContainerLow}"
                                            BorderBrush="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                            MinWidth="112"
                                            MaxWidth="280"
                                            Padding="0,8"
                                            SnapsToDevicePixels="True">
                                        <StackPanel x:Name="PART_SubItemsPanel"/>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <Trigger Property="IsSubMenuOpen" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
