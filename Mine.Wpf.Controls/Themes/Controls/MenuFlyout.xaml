<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Mine.Wpf.Controls.Controls">

    <!-- ═══════════════════════════════════════════════════════════════
         MenuFlyout 样式
         ════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:MenuFlyout}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyout}">
                    <Popup x:Name="PART_Popup"
                           AllowsTransparency="True"
                           StaysOpen="False"
                           PopupAnimation="None"
                           Placement="{TemplateBinding Placement}"
                           PlacementTarget="{TemplateBinding PlacementTarget}">
                        <Border x:Name="PART_Container"
                                Background="{DynamicResource Mine.Brush.SurfaceContainer}"
                                CornerRadius="4"
                                MinWidth="{TemplateBinding MenuMinWidth}"
                                MaxWidth="{TemplateBinding MenuMaxWidth}"
                                Padding="0,8"
                                Effect="{DynamicResource Mine.Elevation.2}">
                            <StackPanel x:Name="PART_ItemsPanel" />
                        </Border>
                    </Popup>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MenuFlyoutItem 样式
         ════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:MenuFlyoutItem}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutItem}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <ContentPresenter x:Name="IconPresenter"
                                            Grid.Column="0"
                                            Content="{TemplateBinding Icon}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Width="24"
                                            Height="24"
                                            Visibility="Collapsed" />

                            <!-- 文本 -->
                            <TextBlock Grid.Column="1"
                                     Text="{TemplateBinding Text}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     FontSize="14" />

                            <!-- 快捷键 -->
                            <TextBlock x:Name="AcceleratorText"
                                     Grid.Column="2"
                                     Text="{TemplateBinding KeyboardAcceleratorTextOverride}"
                                     Margin="24,0,0,0"
                                     VerticalAlignment="Center"
                                     FontSize="12"
                                                       Opacity="0.6"
                                                       Visibility="Collapsed" />
                                                  </Grid>
                                              </Border>

                                              <ControlTemplate.Triggers>
                                                  <!-- 图标显示触发器 -->
                                                  <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource Self}, Converter={StaticResource Mine.Internal.NullToBoolConv}}" Value="False">
                                                      <Setter TargetName="IconPresenter" Property="Visibility" Value="Visible" />
                                                  </DataTrigger>

                                                  <!-- 快捷键显示触发器 -->
                        <DataTrigger Binding="{Binding KeyboardAcceleratorTextOverride, RelativeSource={RelativeSource Self}, Converter={StaticResource Mine.Internal.StringIsNotNullConv}}" Value="True">
                            <Setter TargetName="AcceleratorText" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- 悬停效果 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Mine.Brush.OnSurface}" />
                            <Setter TargetName="Border" Property="Opacity" Value="0.08" />
                        </Trigger>

                        <!-- 禁用状态 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MenuFlyoutSeparator 样式
         ════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:MenuFlyoutSeparator}">
        <Setter Property="Height" Value="9" />
        <Setter Property="Margin" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutSeparator}">
                    <Border Height="1"
                            Background="{DynamicResource Mine.Brush.OutlineVariant}"
                            VerticalAlignment="Center"
                            Margin="0,4" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         MenuFlyoutSubItem 样式
         ════════════════════════════════════════════════════════════════ -->
    <Style TargetType="{x:Type c:MenuFlyoutSubItem}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type c:MenuFlyoutSubItem}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            Height="{TemplateBinding Height}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- 图标 -->
                            <ContentPresenter x:Name="IconPresenter"
                                            Grid.Column="0"
                                            Content="{TemplateBinding Icon}"
                                            Margin="0,0,12,0"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Width="24"
                                            Height="24"
                                            Visibility="Collapsed" />

                            <!-- 文本 -->
                            <TextBlock Grid.Column="1"
                                     Text="{TemplateBinding Text}"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     FontSize="14" />

                            <!-- 展开箭头 -->
                            <c:MaterialIcon Grid.Column="2"
                                          Kind="chevron_right"
                                          Size="20"
                                          VerticalAlignment="Center"
                                          Margin="12,0,0,0" />

                            <!-- 子菜单弹出层 -->
                            <Popup x:Name="PART_SubMenuPopup"
                                   AllowsTransparency="True"
                                   StaysOpen="False"
                                   Placement="Right"
                                   PlacementTarget="{Binding ElementName=Border}"
                                   IsOpen="{TemplateBinding IsSubMenuOpen}">
                                <Border Background="{DynamicResource Mine.Brush.SurfaceContainer}"
                                        CornerRadius="4"
                                        MinWidth="112"
                                        MaxWidth="280"
                                        Padding="0,8"
                                        Effect="{DynamicResource Mine.Elevation.2}">
                                    <StackPanel x:Name="PART_SubItemsPanel" />
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- 图标显示触发器 -->
                        <DataTrigger Binding="{Binding Icon, RelativeSource={RelativeSource Self}, Converter={StaticResource Mine.Internal.NullToBoolConv}}" Value="False">
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- 悬停效果 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource Mine.Brush.OnSurface}" />
                            <Setter TargetName="Border" Property="Opacity" Value="0.08" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
