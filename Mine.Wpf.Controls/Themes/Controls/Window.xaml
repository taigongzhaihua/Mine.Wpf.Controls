<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <!-- Caption button base style (close / max / min) -->
    <Style x:Key="Mine.Internal.CaptionButton" TargetType="Button">
        <Setter Property="Width"            Value="46"/>
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.12"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Close button overrides hover color to Error -->
    <Style x:Key="Mine.Internal.CloseButton" TargetType="Button"
           BasedOn="{StaticResource Mine.Internal.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Mine.Brush.Error}"/>
                <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnError}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- �T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T
         MineWindow style
         �T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T�T -->
    <Style TargetType="{x:Type controls:Window}">
        <Setter Property="Background"       Value="{DynamicResource Mine.Brush.Background}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnBackground}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontFamily"       Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"         Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Window}">
                    <Border x:Name="WindowRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleBarRow" Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Title Bar -->
                            <Grid x:Name="PART_TitleBar"
                                  Grid.Row="0"
                                  Background="Transparent">

                                <!-- App title / custom content -->
                                <ContentPresenter x:Name="TitleContent"
                                                  Content="{TemplateBinding TitleBarContent}"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,138,0"/>

                                <!-- Fallback: show Title text when TitleBarContent is null -->
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,138,0"
                                           Visibility="Collapsed"
                                           FontSize="{DynamicResource Mine.FontSize.TitleSmall}"
                                           FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}"/>

                                <!-- Caption buttons -->
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button x:Name="PART_Minimize"
                                            Style="{StaticResource Mine.Internal.CaptionButton}"
                                            ToolTip="��С��">
                                        <Path Data="M4,8 H12" Stroke="{DynamicResource Mine.Brush.OnSurface}"
                                              StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                    </Button>
                                    <Button x:Name="PART_Maximize"
                                            Style="{StaticResource Mine.Internal.CaptionButton}"
                                            ToolTip="���">
                                        <Path x:Name="MaxIcon"
                                              Data="M3,3 H13 V13 H3 Z"
                                              Stroke="{DynamicResource Mine.Brush.OnSurface}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                    </Button>
                                    <Button x:Name="PART_Close"
                                            Style="{StaticResource Mine.Internal.CloseButton}"
                                            ToolTip="�ر�">
                                        <Path Data="M4,4 L12,12 M12,4 L4,12"
                                              Stroke="{DynamicResource Mine.Brush.OnSurface}"
                                              StrokeThickness="1.5" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Window content -->
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hide TitleBar when ShowTitleBar=False -->
                        <Trigger Property="ShowTitleBar" Value="False">
                            <Setter TargetName="TitleBarRow" Property="Height" Value="0"/>
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <!-- Show title text only when TitleBarContent is null -->
                        <Trigger Property="TitleBarContent" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <!-- Maximized: adjust window chrome corners -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowRoot" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="WindowRoot" Property="Margin"       Value="8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>


