<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">
    <!-- Caption button base style (close / max / min) -->
    <Style x:Key="Mine.Internal.CaptionButton" TargetType="Button">
        <Setter Property="Width"            Value="46"/>
        <Setter Property="Height"           Value="32"/>
        <Setter Property="Background"       Value="Transparent"/>
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.12"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Close button overrides hover color to Error -->
    <Style x:Key="Mine.Internal.CloseButton" TargetType="Button"
           BasedOn="{StaticResource Mine.Internal.CaptionButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Mine.Brush.Error}"/>
                <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnError}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type controls:Window}">
        <Setter Property="Background"       Value="{DynamicResource Mine.Brush.Background}"/>
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnBackground}"/>
        <Setter Property="BorderThickness"  Value="0"/>
        <Setter Property="FontFamily"       Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"         Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Window}">
                    <Border x:Name="WindowRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="TitleBarRow" Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="PART_TitleBar"
                                  Grid.Row="0"
                                  Background="Transparent">
                                <ContentPresenter x:Name="TitleContent"
                                                  Content="{TemplateBinding TitleBarContent}"
                                                  VerticalAlignment="Center"
                                                  Margin="16,0,138,0"/>
                                <TextBlock x:Name="TitleText"
                                           Text="{TemplateBinding Title}"
                                           VerticalAlignment="Center"
                                           Margin="16,0,138,0"
                                           Visibility="Collapsed"
                                           FontSize="{DynamicResource Mine.FontSize.TitleSmall}"
                                           FontWeight="Medium"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button x:Name="PART_Minimize"
                                            Style="{StaticResource Mine.Internal.CaptionButton}"
                                            ToolTip="最小化">
                                        <controls:MaterialIcon Kind="Minimize" Size="16"
                                                               Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                                    </Button>
                                    <Button x:Name="PART_Maximize"
                                            Style="{StaticResource Mine.Internal.CaptionButton}"
                                            ToolTip="最大化">
                                        <controls:MaterialIcon x:Name="MaxIcon" Kind="PanoramaWideAngle" Size="16"
                                                               Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                                    </Button>
                                    <Button x:Name="PART_Close"
                                            Style="{StaticResource Mine.Internal.CloseButton}"
                                            ToolTip="关闭">
                                        <controls:MaterialIcon Kind="Clear" Size="16"
                                                               Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <AdornerDecorator Grid.Row="1">
                                <ContentPresenter/>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowTitleBar" Value="False">
                            <Setter TargetName="TitleBarRow" Property="Height" Value="0"/>
                            <Setter TargetName="PART_TitleBar" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="TitleBarContent" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowRoot" Property="CornerRadius" Value="0"/>
                            <Setter TargetName="WindowRoot" Property="Padding" Value="8"/>
                            <Setter TargetName="MaxIcon" Property="Kind" Value="Lens"/>
                            <Setter TargetName="PART_Maximize" Property="ToolTip" Value="还原"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
