<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <Style TargetType="{x:Type controls:Switch}">
        <Setter Property="Foreground"       Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="FontFamily"       Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"         Value="{DynamicResource Mine.FontSize.BodyMedium}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Cursor"           Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Switch}">
                    <!--
                        Track : 52×32，Rectangle RadiusX/Y=16
                        Off   : Thumb ⌀16，圆心=(16,16) → Left=8,  Top=8
                        On    : Thumb ⌀24，圆心=(36,16) → Left=24, Top=4（四边距均=4px）
                        Ripple: ⌀40 同心于 Thumb
                        Icon  : Grid 容器与 Thumb 等位/等尺寸，内含 OffIcon+OnIcon 交叉淡入淡出
                                Off FontSize=10（适配⌀16），On FontSize=14（适配⌀24）
                    -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CheckStates">

                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.2">
                                        <VisualTransition.GeneratedEasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </VisualTransition.GeneratedEasingFunction>
                                    </VisualTransition>
                                </VisualStateGroup.Transitions>

                                <!-- ── Off（Unchecked）── -->
                                <VisualState x:Name="Unchecked">
                                    <Storyboard>
                                        <!-- Thumb -->
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="(Canvas.Left)" To="8"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="(Canvas.Top)"  To="8"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="Width"          To="16" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="Height"         To="16" Duration="0"/>
                                        <!-- Ripple -->
                                        <DoubleAnimation Storyboard.TargetName="Ripple"         Storyboard.TargetProperty="(Canvas.Left)" To="-4" Duration="0"/>
                                        <!-- IconContainer 跟随 Thumb -->
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="(Canvas.Left)" To="8"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="(Canvas.Top)"  To="8"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="Width"          To="16" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="Height"         To="16" Duration="0"/>
                                        <!-- 图标交叉：OffIcon 淡入，OnIcon 淡出 -->
                                        <DoubleAnimation Storyboard.TargetName="OffIconText"    Storyboard.TargetProperty="Opacity"        To="1"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OnIconText"     Storyboard.TargetProperty="Opacity"        To="0"  Duration="0"/>
                                    </Storyboard>
                                </VisualState>

                                <!-- ── On（Checked）── -->
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <!-- Thumb -->
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="(Canvas.Left)" To="24" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="(Canvas.Top)"  To="4"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="Width"          To="24" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="Thumb"          Storyboard.TargetProperty="Height"         To="24" Duration="0"/>
                                        <!-- Ripple -->
                                        <DoubleAnimation Storyboard.TargetName="Ripple"         Storyboard.TargetProperty="(Canvas.Left)" To="16" Duration="0"/>
                                        <!-- IconContainer 跟随 Thumb -->
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="(Canvas.Left)" To="24" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="(Canvas.Top)"  To="4"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="Width"          To="24" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="IconContainer"  Storyboard.TargetProperty="Height"         To="24" Duration="0"/>
                                        <!-- 图标交叉：OnIcon 淡入，OffIcon 淡出 -->
                                        <DoubleAnimation Storyboard.TargetName="OnIconText"     Storyboard.TargetProperty="Opacity"        To="1"  Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="OffIconText"    Storyboard.TargetProperty="Opacity"        To="0"  Duration="0"/>
                                    </Storyboard>
                                </VisualState>

                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid Width="52" Height="32" VerticalAlignment="Center">

                            <!-- Track -->
                            <Rectangle x:Name="Track"
                                       Width="52" Height="32"
                                       RadiusX="16" RadiusY="16"
                                       StrokeThickness="2"
                                       Fill="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                       Stroke="{DynamicResource Mine.Brush.Outline}"/>

                            <Canvas Width="52" Height="32" ClipToBounds="False">

                                <!-- Ripple（⌀40，同心于 Thumb，Top 固定=-4） -->
                                <Ellipse x:Name="Ripple"
                                         Width="40" Height="40"
                                         Canvas.Left="-4" Canvas.Top="-4"
                                         Fill="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                         Opacity="0"/>

                                <!-- Thumb（VSM 驱动位置和尺寸，初始=Off） -->
                                <Ellipse x:Name="Thumb"
                                         Width="16" Height="16"
                                         Canvas.Left="8" Canvas.Top="8"
                                         Fill="{DynamicResource Mine.Brush.Outline}"/>

                                <!--
                                    图标容器：Grid 使内部 TextBlock 可 VerticalAlignment/HorizontalAlignment 居中。
                                    VSM 同步驱动其 Canvas.Left/Top/Width/Height 与 Thumb 一致。
                                    初始位置=Off（8,8,16,16）。
                                -->
                                <Grid x:Name="IconContainer"
                                      Width="16" Height="16"
                                      Canvas.Left="8" Canvas.Top="8"
                                      IsHitTestVisible="False">

                                    <!-- Off 图标：FontSize=10，适配 ⌀16 圆；Checked 时淡出 -->
                                    <TextBlock x:Name="OffIconText"
                                               Text="{TemplateBinding OffIcon}"
                                               FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                                               Opacity="1"/>

                                    <!-- On 图标：FontSize=14，适配 ⌀24 圆；Unchecked 时淡出 -->
                                    <TextBlock x:Name="OnIconText"
                                               Text="{TemplateBinding OnIcon}"
                                               FontFamily="{DynamicResource Mine.Font.MaterialSymbols}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"
                                               Opacity="0"/>
                                </Grid>
                            </Canvas>
                        </Grid>

                        <!-- 标签 -->
                        <ContentPresenter Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </StackPanel>

                    <ControlTemplate.Triggers>
                        <!-- 颜色（DynamicResource 仅在 Setter 中有效） -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track"      Property="Fill"   Value="{DynamicResource Mine.Brush.Primary}"/>
                            <Setter TargetName="Track"      Property="Stroke" Value="{DynamicResource Mine.Brush.Primary}"/>
                            <Setter TargetName="Thumb"      Property="Fill"   Value="{DynamicResource Mine.Brush.OnPrimary}"/>
                            <Setter TargetName="Ripple"     Property="Fill"   Value="{DynamicResource Mine.Brush.Primary}"/>
                            <Setter TargetName="OffIconText" Property="Foreground" Value="{DynamicResource Mine.Brush.Primary}"/>
                        </Trigger>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ripple" Property="Opacity" Value="0.08"/>
                        </Trigger>
                        <!-- Pressed -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Ripple" Property="Opacity" Value="0.12"/>
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

