<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">

    <!--
    ══════════════════════════════════════════════════════════════
     TagBox — Material Design 3
     标签输入框控件,支持添加、删除和显示多个标签
     - 使用 Input Chip 显示标签
     - 支持 Enter 添加标签
     - 支持 Backspace 删除最后一个标签
     - 支持设置最大标签数和禁止重复
    ══════════════════════════════════════════════════════════════
    -->
    <Style TargetType="{x:Type controls:TagBox}">
        <Setter Property="MinHeight"           Value="56"/>
        <Setter Property="Padding"             Value="16,8"/>
        <Setter Property="FontFamily"          Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"            Value="{DynamicResource Mine.FontSize.BodyLarge}"/>
        <Setter Property="Foreground"          Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="Background"          Value="{DynamicResource Mine.Brush.SurfaceContainerHighest}"/>
        <Setter Property="BorderBrush"         Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
        <Setter Property="BorderThickness"     Value="0,0,0,1"/>
        <Setter Property="FocusVisualStyle"    Value="{x:Null}"/>
        <Setter Property="AcceptsReturn"       Value="False"/>
        <Setter Property="TextWrapping"        Value="NoWrap"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- 光标颜色 - 使用主题色 -->
        <Setter Property="CaretBrush"          Value="{DynamicResource Mine.Brush.Primary}"/>
        <!-- 选中文本的背景色 - 使用主题色的半透明版本 -->
        <Setter Property="SelectionBrush"      Value="{DynamicResource Mine.Brush.Primary}"/>
        <Setter Property="SelectionOpacity"    Value="0.4"/>
        <!-- 选中文本的前景色 -->
        <Setter Property="SelectionTextBrush"  Value="{DynamicResource Mine.Brush.OnPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TagBox}">
                    <Grid>
                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Mine.Shape.ExtraSmall}"
                                Padding="{TemplateBinding Padding}">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 标签面板 -->
                                <ItemsControl x:Name="PART_TagsPanel" 
                                              Grid.Column="0"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>

                                <!-- TextBox 内容宿主 -->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Column="1"
                                              Margin="4,0,0,0"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="Hidden"
                                              VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- 底部指示线(Focused 状态) -->
                        <Border x:Name="FocusIndicator"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource Mine.Brush.Primary}"
                                Opacity="0"
                                CornerRadius="1"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0"
                                                         Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Container" Property="Opacity" Value="0.38"/>
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource Mine.Brush.OnSurface}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
