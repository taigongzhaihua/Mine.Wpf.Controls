<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls"
                    xmlns:conv="clr-namespace:Mine.Wpf.Controls.Converters">

    <conv:RoundedRectClipConverter x:Key="Local.SettingsGroupClipConv"/>

    <!-- ═══ SettingsGroupItem ═══════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:SettingsGroupItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroupItem}">
                    <StackPanel>
                        <ContentPresenter/>
                        <Border x:Name="Divider"
                                Height="1"
                                Margin="16,4"
                                Background="{DynamicResource Mine.Brush.OutlineVariant}"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsLast" Value="True">
                            <Setter TargetName="Divider" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══ SettingsGroup ═══════════════════════════════════════════════ -->
    <Style TargetType="{x:Type controls:SettingsGroup}">
        <Setter Property="Background"          Value="{DynamicResource Mine.Brush.SurfaceContainerLow}"/>
        <Setter Property="Foreground"          Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="BorderThickness"     Value="0"/>
        <Setter Property="CornerRadius"        Value="{DynamicResource Mine.Shape.Medium}"/>
        <Setter Property="Effect"              Value="{DynamicResource Mine.Elevation.1}"/>
        <Setter Property="SnapsToDevicePixels"  Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SettingsGroup}">
                    <StackPanel>
                        <!-- 分组标题（位于卡片外部上方） -->
                        <ContentPresenter x:Name="HeaderPresenter"
                                          Content="{TemplateBinding Header}"
                                          Margin="16,0,16,8"
                                          TextBlock.FontFamily="{DynamicResource Mine.FontFamily.Default}"
                                          TextBlock.FontSize="{DynamicResource Mine.FontSize.TitleSmall}"
                                          TextBlock.FontWeight="Medium"
                                          TextBlock.Foreground="{DynamicResource Mine.Brush.Primary}"/>

                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Effect="{TemplateBinding Effect}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Border.Clip>
                                <MultiBinding Converter="{StaticResource Local.SettingsGroupClipConv}">
                                    <Binding Path="ActualWidth"  RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource Self}"/>
                                    <Binding Path="CornerRadius" RelativeSource="{RelativeSource Self}"/>
                                </MultiBinding>
                            </Border.Clip>
                            <ItemsPresenter/>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="HeaderPresenter" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel/>
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
