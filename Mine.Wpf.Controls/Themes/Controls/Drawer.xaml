<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">
    <!--
    ══════════════════════════════════════════════════════════════
     Drawer — Material Design 3 Navigation Drawer
     模板结构：
       Grid（填满父容器）
       ├─ ContentPresenter          ← 主体内容
       ├─ Border PART_Scrim         ← 半透明遮罩（Opacity 动画）
       └─ Border PART_DrawerPanel   ← 抽屉面板（TranslateTransform 动画）
            └─ ContentPresenter(DrawerContent)
     IsOpen 由 Drawer.cs 代码驱动动画，无 VSM/Trigger。
    ══════════════════════════════════════════════════════════════
    -->
    <!--
    ══════════════════════════════════════════════════════════════
     Mine.Style.NavItem — 抽屉导航项 RadioButton 样式
     高度 56，完整圆角（CornerRadius=28），选中 SecondaryContainer
    ══════════════════════════════════════════════════════════════
    -->
    <Style x:Key="Mine.Style.NavItem" TargetType="RadioButton">
        <Setter Property="Height"          Value="56"/>
        <Setter Property="Padding"         Value="16,0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
        <Setter Property="FontFamily"      Value="{DynamicResource Mine.FontFamily.Default}"/>
        <Setter Property="FontSize"        Value="{DynamicResource Mine.FontSize.LabelLarge}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            CornerRadius="28"
                            ClipToBounds="True">
                        <Border x:Name="StateLayer"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background"
                                    Value="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StateLayer" Property="Background">
                                <Setter.Value>
                                    <SolidColorBrush Color="{DynamicResource Mine.Color.OnSurface}" Opacity="0.08"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:Drawer}">
        <Setter Property="Focusable"                  Value="False"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment"   Value="Stretch"/>
        <Setter Property="DrawerWidth"                Value="320"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:Drawer}">
                    <Grid ClipToBounds="True">
                        <!-- 主体内容 -->
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        <!--
                            遮罩层：覆盖主体内容，点击可关闭抽屉。
                            Opacity 由代码驱动动画（0 → ScrimOpacity）
                        -->
                        <Border x:Name="PART_Scrim"
                                Background="{DynamicResource Mine.Brush.Scrim}"
                                Opacity="0"
                                Visibility="Collapsed"/>

                        <!--
                            抽屉面板：默认从左侧定位
                            HorizontalAlignment / VerticalAlignment 由触发器按 DrawerPlacement 设置
                            Width / Height 由 TemplateBinding 提供
                            TranslateTransform 由代码驱动滑入/滑出动画
                        -->
                        <Border x:Name="PART_DrawerPanel"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Stretch"
                                Width="{TemplateBinding DrawerWidth}"
                                Background="{DynamicResource Mine.Brush.Surface}"
                                Visibility="Collapsed">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                  Opacity="0.2"
                                                  Color="{DynamicResource Mine.Color.Shadow}"/>
                            </Border.Effect>
                            <ContentPresenter Content="{TemplateBinding DrawerContent}"
                                              ContentTemplate="{TemplateBinding DrawerContentTemplate}"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Right 方向 -->
                        <Trigger Property="DrawerPlacement" Value="Right">
                            <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment"   Value="Stretch"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Width"
                                    Value="{Binding DrawerWidth, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Height" Value="NaN"/>
                        </Trigger>
                        <!-- Top 方向 -->
                        <Trigger Property="DrawerPlacement" Value="Top">
                            <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment"   Value="Top"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Width"               Value="NaN"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Height"
                                    Value="{Binding DrawerHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                        <!-- Bottom 方向 -->
                        <Trigger Property="DrawerPlacement" Value="Bottom">
                            <Setter TargetName="PART_DrawerPanel" Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter TargetName="PART_DrawerPanel" Property="VerticalAlignment"   Value="Bottom"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Width"               Value="NaN"/>
                            <Setter TargetName="PART_DrawerPanel" Property="Height"
                                    Value="{Binding DrawerHeight, RelativeSource={RelativeSource TemplatedParent}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>


