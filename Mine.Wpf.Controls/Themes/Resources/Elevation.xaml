<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Material 3 海拔等级
        通过 DropShadowEffect 资源实现（等级 0-5）。
        表面着色叠加层透明度见 ElevationToOpacityConverter。
    -->
    <DropShadowEffect x:Key="Mine.Elevation.0" BlurRadius="0"  ShadowDepth="0"  Opacity="0"    Color="#000000"/>
    <DropShadowEffect x:Key="Mine.Elevation.1" BlurRadius="10" ShadowDepth="2"  Opacity="0.28" Color="#000000"/>
    <DropShadowEffect x:Key="Mine.Elevation.2" BlurRadius="16" ShadowDepth="4"  Opacity="0.30" Color="#000000"/>
    <DropShadowEffect x:Key="Mine.Elevation.3" BlurRadius="22" ShadowDepth="6"  Opacity="0.32" Color="#000000"/>
    <DropShadowEffect x:Key="Mine.Elevation.4" BlurRadius="28" ShadowDepth="8"  Opacity="0.34" Color="#000000"/>
    <DropShadowEffect x:Key="Mine.Elevation.5" BlurRadius="38" ShadowDepth="12" Opacity="0.36" Color="#000000"/>
    <!-- 各海拔等级的表面着色透明度（在模板中作为 Border Opacity 使用） -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.0">0.00</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.1">0.05</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.2">0.08</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.3">0.11</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.4">0.12</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="Mine.Elevation.TintOpacity.5">0.14</sys:Double>
</ResourceDictionary>
