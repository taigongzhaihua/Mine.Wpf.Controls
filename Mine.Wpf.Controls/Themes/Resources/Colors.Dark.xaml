<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Mine.Wpf.Controls;component/Themes/Resources/ColorBrushes.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <!--
        Material 3 颜色角色 - 暗色主题（默认种子色：#6750A4）
        ThemeManager 会在自定义种子色时动态覆盖 Color 资源。
    -->
    <!-- 主色 -->
    <Color x:Key="Mine.Color.Primary">#FFD0BCFF</Color>
    <Color x:Key="Mine.Color.OnPrimary">#FF381E72</Color>
    <Color x:Key="Mine.Color.PrimaryContainer">#FF4F378B</Color>
    <Color x:Key="Mine.Color.OnPrimaryContainer">#FFEADDFF</Color>
    <!-- 次要色 -->
    <Color x:Key="Mine.Color.Secondary">#FFCCC2DC</Color>
    <Color x:Key="Mine.Color.OnSecondary">#FF332D41</Color>
    <Color x:Key="Mine.Color.SecondaryContainer">#FF4A4458</Color>
    <Color x:Key="Mine.Color.OnSecondaryContainer">#FFE8DEF8</Color>
    <!-- 第三色 -->
    <Color x:Key="Mine.Color.Tertiary">#FFEFB8C8</Color>
    <Color x:Key="Mine.Color.OnTertiary">#FF492532</Color>
    <Color x:Key="Mine.Color.TertiaryContainer">#FF633B48</Color>
    <Color x:Key="Mine.Color.OnTertiaryContainer">#FFFFD8E4</Color>
    <!-- 错误色 -->
    <Color x:Key="Mine.Color.Error">#FFF2B8B5</Color>
    <Color x:Key="Mine.Color.OnError">#FF601410</Color>
    <Color x:Key="Mine.Color.ErrorContainer">#FF8C1D18</Color>
    <Color x:Key="Mine.Color.OnErrorContainer">#FFF9DEDC</Color>
    <!-- 表面色 -->
    <Color x:Key="Mine.Color.Surface">#FF141218</Color>
    <Color x:Key="Mine.Color.OnSurface">#FFE6E0E9</Color>
    <Color x:Key="Mine.Color.SurfaceVariant">#FF49454F</Color>
    <Color x:Key="Mine.Color.OnSurfaceVariant">#FFCAC4D0</Color>
    <Color x:Key="Mine.Color.SurfaceTint">#FFD0BCFF</Color>
    <Color x:Key="Mine.Color.SurfaceContainerLowest">#FF0F0D13</Color>
    <Color x:Key="Mine.Color.SurfaceContainerLow">#FF1D1B20</Color>
    <Color x:Key="Mine.Color.SurfaceContainer">#FF211F26</Color>
    <Color x:Key="Mine.Color.SurfaceContainerHigh">#FF2B2930</Color>
    <Color x:Key="Mine.Color.SurfaceContainerHighest">#FF36343B</Color>
    <!-- 背景色 -->
    <Color x:Key="Mine.Color.Background">#FF141218</Color>
    <Color x:Key="Mine.Color.OnBackground">#FFE6E0E9</Color>
    <!-- 轮廓色 -->
    <Color x:Key="Mine.Color.Outline">#FF938F99</Color>
    <Color x:Key="Mine.Color.OutlineVariant">#FF49454F</Color>
    <!-- 反转色 -->
    <Color x:Key="Mine.Color.InverseSurface">#FFE6E0E9</Color>
    <Color x:Key="Mine.Color.InverseOnSurface">#FF322F35</Color>
    <Color x:Key="Mine.Color.InversePrimary">#FF6750A4</Color>
    <!-- 其他 -->
    <Color x:Key="Mine.Color.Shadow">#FF000000</Color>
    <Color x:Key="Mine.Color.Scrim">#FF000000</Color>
    <!-- 语义色：警告 -->
    <Color x:Key="Mine.Color.Warning">#FFFFB951</Color>
    <Color x:Key="Mine.Color.OnWarning">#FF3F2B00</Color>
    <Color x:Key="Mine.Color.WarningContainer">#FF5B3F00</Color>
    <Color x:Key="Mine.Color.OnWarningContainer">#FFFFDF99</Color>
    <!-- 语义色：成功 -->
    <Color x:Key="Mine.Color.Success">#FF9AE4A4</Color>
    <Color x:Key="Mine.Color.OnSuccess">#FF00391A</Color>
    <Color x:Key="Mine.Color.SuccessContainer">#FF005227</Color>
    <Color x:Key="Mine.Color.OnSuccessContainer">#FFB5F2BB</Color>
    <!-- 语义色：信息 -->
    <Color x:Key="Mine.Color.Info">#FF7DD3FC</Color>
    <Color x:Key="Mine.Color.OnInfo">#FF003549</Color>
    <Color x:Key="Mine.Color.InfoContainer">#FF004B6A</Color>
    <Color x:Key="Mine.Color.OnInfoContainer">#FFC5E7FF</Color>
</ResourceDictionary>

