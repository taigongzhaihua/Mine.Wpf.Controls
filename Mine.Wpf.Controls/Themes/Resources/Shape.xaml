<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Material 3 形状比例
        用法：CornerRadius="{DynamicResource Mine.Shape.Medium}"
        注意：Mine.Shape.Full 使用魔数 9999，由 CornerRadiusFilterConverter 在运行时
              根据实际尺寸按比例压缩，以实现完美的药丸形（Pill）或圆形效果。
    -->
    <CornerRadius x:Key="Mine.Shape.None">0</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.ExtraSmall">4</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Small">8</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Medium">12</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Large">16</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.ExtraLarge">28</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Full">9999</CornerRadius>
    <!-- 仅上侧圆角（用于 Filled TextField） -->
    <CornerRadius x:Key="Mine.Shape.ExtraSmall.Top">4,4,0,0</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Small.Top">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Medium.Top">12,12,0,0</CornerRadius>
    <CornerRadius x:Key="Mine.Shape.Large.Top">16,16,0,0</CornerRadius>
</ResourceDictionary>
