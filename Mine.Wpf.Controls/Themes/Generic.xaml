<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls">
    <!--
        Mine.Wpf.Controls — Generic.xaml
        入口文件：合并所有设计令牌与控件样式字典。
    -->

    <!-- Material Symbols 字体引用 -->
    <FontFamily x:Key="Mine.Font.MaterialSymbols">pack://application:,,,/Mine.Wpf.Controls;component/Fonts/#Material Symbols Rounded</FontFamily>

    <!-- MaterialIcon 默认样式 -->
    <Style TargetType="{x:Type controls:MaterialIcon}">
        <Setter Property="Foreground" Value="{DynamicResource Mine.Brush.OnSurface}"/>
        <Setter Property="Size"       Value="24"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:MaterialIcon}">
                    <!-- FontFamily/FontSize/FontWeight 由 UpdateText() 在代码中设置，不在此处硬编码 -->
                    <TextBlock x:Name="PART_Text"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{TemplateBinding Foreground}"
                               TextAlignment="Center"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ResourceDictionary.MergedDictionaries>
