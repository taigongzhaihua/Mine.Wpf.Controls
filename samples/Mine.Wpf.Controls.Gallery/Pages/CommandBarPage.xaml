<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.CommandBarPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="CommandBar"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <!-- ── 基础命令栏 ───────────────────────────────────────────── -->
        <TextBlock Text="基础命令栏"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <mine:CommandBar HorizontalAlignment="Left">
                <mine:CommandBar.PrimaryCommands>
                    <mine:AppBarButton Label="新建">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="Add" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                    <mine:AppBarButton Label="打开">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="FolderOpen" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                    <mine:AppBarButton Label="保存">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="Save" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                    <mine:AppBarSeparator/>
                    <mine:AppBarToggleButton Label="收藏">
                        <mine:AppBarToggleButton.Icon>
                            <mine:MaterialIcon Kind="Star" Size="20"/>
                        </mine:AppBarToggleButton.Icon>
                    </mine:AppBarToggleButton>
                </mine:CommandBar.PrimaryCommands>
                <mine:CommandBar.SecondaryCommands>
                    <mine:MenuFlyoutItem Text="打印">
                        <mine:MenuFlyoutItem.Icon>
                            <mine:MaterialIcon Kind="Print" Size="20"/>
                        </mine:MenuFlyoutItem.Icon>
                    </mine:MenuFlyoutItem>
                    <mine:MenuFlyoutItem Text="分享">
                        <mine:MenuFlyoutItem.Icon>
                            <mine:MaterialIcon Kind="Share" Size="20"/>
                        </mine:MenuFlyoutItem.Icon>
                    </mine:MenuFlyoutItem>
                    <mine:MenuFlyoutSeparator/>
                    <mine:MenuFlyoutItem Text="设置">
                        <mine:MenuFlyoutItem.Icon>
                            <mine:MaterialIcon Kind="Settings" Size="20"/>
                        </mine:MenuFlyoutItem.Icon>
                    </mine:MenuFlyoutItem>
                </mine:CommandBar.SecondaryCommands>
            </mine:CommandBar>
        </mine:Card>

        <!-- ── 紧凑命令栏（无标签） ─────────────────────────────────── -->
        <TextBlock Text="紧凑命令栏（仅图标）"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <mine:CommandBar HorizontalAlignment="Left">
                <mine:CommandBar.PrimaryCommands>
                    <mine:AppBarButton IsCompact="True" Label="剪切">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="ContentCut" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                    <mine:AppBarButton IsCompact="True" Label="复制">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="ContentCopy" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                    <mine:AppBarButton IsCompact="True" Label="粘贴">
                        <mine:AppBarButton.Icon>
                            <mine:MaterialIcon Kind="ContentPaste" Size="20"/>
                        </mine:AppBarButton.Icon>
                    </mine:AppBarButton>
                </mine:CommandBar.PrimaryCommands>
            </mine:CommandBar>
        </mine:Card>

    </StackPanel>
</mine:Page>
