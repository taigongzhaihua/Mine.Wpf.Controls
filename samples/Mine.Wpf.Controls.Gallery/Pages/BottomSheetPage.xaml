<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.BottomSheetPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Bottom Sheet"
           Padding="0"
           IsScrollable="False">

    <!--
        BottomSheetPage：整个页面是一个 BottomSheet 容器，
        主体内容在下方，演示面板通过按钮触发。
    -->
    <mine:BottomSheet x:Name="DemoSheet"
                      Variant="Modal"
                      CloseOnScrimClick="True"
                      ShowDragHandle="True"
                      EnableDragToClose="True">

        <!-- Sheet 内容 -->
        <mine:BottomSheet.SheetContent>
            <StackPanel x:Name="SheetContentPanel" Margin="24,0,24,32">
                <TextBlock x:Name="SheetTitle"
                           Text="操作菜单"
                           Style="{DynamicResource Mine.Typography.TitleLarge}"
                           Margin="0,0,0,16"/>

                <!-- 操作项列表（默认） -->
                <StackPanel x:Name="ActionPanel">
                    <mine:Button Style="{DynamicResource Mine.Style.Button.Text}"
                                 Icon="&#xE2C7;"
                                 Content="分享"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Height="52"
                                 Padding="12,0"/>
                    <mine:Button Style="{DynamicResource Mine.Style.Button.Text}"
                                 Icon="&#xE14D;"
                                 Content="复制链接"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Height="52"
                                 Padding="12,0"/>
                    <mine:Button Style="{DynamicResource Mine.Style.Button.Text}"
                                 Icon="&#xE88A;"
                                 Content="加入收藏"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Height="52"
                                 Padding="12,0"/>
                    <mine:Button Style="{DynamicResource Mine.Style.Button.Text}"
                                 Icon="&#xE872;"
                                 Content="删除"
                                 Foreground="{DynamicResource Mine.Brush.Error}"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Left"
                                 Height="52"
                                 Padding="12,0"/>
                </StackPanel>
            </StackPanel>
        </mine:BottomSheet.SheetContent>

        <!-- 主体内容 -->
        <Grid Background="{DynamicResource Mine.Brush.Background}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,32" MaxWidth="760">

                    <TextBlock Text="Bottom Sheet"
                               Style="{DynamicResource Mine.Typography.HeadlineMedium}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="从底部滑入的面板，用于展示与当前页面内容相关的补充操作或信息。支持模态（Modal）与标准（Standard）两种变体，以及向下拖拽关闭交互。"
                               Style="{DynamicResource Mine.Typography.BodyLarge}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28"/>

                    <!-- Modal 变体 -->
                    <TextBlock Text="Modal Bottom Sheet（模态）"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="有半透明遮罩，点击遮罩或向下拖拽超过面板高度 35% 时自动关闭。顶部显示拖拽手柄。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="操作菜单"
                                             Icon="&#xE5D0;"
                                             Margin="0,0,8,0"
                                             Click="OnOpenActionMenu"/>
                                <mine:Button Content="表单面板"
                                             Style="{DynamicResource Mine.Style.Button.FilledTonal}"
                                             Icon="&#xE14B;"
                                             Click="OnOpenForm"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- Standard 变体 -->
                    <TextBlock Text="Standard Bottom Sheet（标准）"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="无遮罩，面板覆盖在内容上方，用户仍可与底层内容交互。适合需要持续展示的辅助内容。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                        <WrapPanel>
                                <mine:Button Content="打开 Standard Sheet"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Icon="&#xE5D0;"
                                             Click="OnOpenStandard"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- 高度控制 -->
                    <TextBlock Text="固定高度"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="通过 SheetHeight 指定固定高度（默认 NaN 自适应内容）；MaxSheetHeight 防止面板超出容器。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="高度 260"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Margin="0,0,8,0"
                                             Click="OnOpenFixed260"/>
                                <mine:Button Content="高度 480"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Click="OnOpenFixed480"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- 属性说明 -->
                    <TextBlock Text="主要属性"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IsOpen"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="bool — 控制面板开关"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Variant"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="Modal（有遮罩）/ Standard（无遮罩）"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SheetHeight"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="double — 面板高度，NaN 为自适应内容"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="ShowDragHandle"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="bool — 是否显示顶部拖拽手柄"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EnableDragToClose"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="bool — 向下拖超过 35% 高度时关闭"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SheetContent"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="object — 面板内容"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                        </StackPanel>
                    </mine:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </mine:BottomSheet>
</mine:Page>
