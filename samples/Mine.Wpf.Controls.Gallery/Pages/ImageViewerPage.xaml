<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.ImageViewerPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="ImageViewer"
           Padding="28,24,28,32">
    <mine:Page.Resources>
        <!-- 内置矢量测试图片 -->
        <DrawingImage x:Key="SampleImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFBBC04">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,800,600"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFEA4335">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="400,300" RadiusX="150" RadiusY="150"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF4285F4">
                        <GeometryDrawing.Geometry>
                            <PathGeometry Figures="M 200,100 L 600,100 L 600,500 L 200,500 Z M 250,150 L 250,450 L 550,450 L 550,150 Z"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#33000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="380,100,40,400"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#33000000">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="200,280,400,40"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </mine:Page.Resources>

    <StackPanel MaxWidth="1200">

        <!-- ── 基本用法 ──────────────────────────────────────────── -->
        <TextBlock Text="基本用法"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <TextBlock Text="支持缩放、拖拽、旋转等交互操作"
                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   Margin="0,0,0,16"/>

        <mine:Card Padding="0" Margin="0,0,0,32">
            <mine:ImageViewer Height="500"
                              Source="{StaticResource SampleImage}"
                              ShowToolbar="True"
                              EnableZoom="True"
                              EnablePan="True"/>
        </mine:Card>

        <!-- ── 功能说明 ──────────────────────────────────────────── -->
        <TextBlock Text="功能说明"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:Card Padding="20" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Style="{DynamicResource Mine.Typography.BodyLarge}"
                           Margin="0,0,0,12">
                    <Run Text="交互操作：" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="• 鼠标滚轮缩放：向上滚动放大，向下滚动缩小"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• 拖拽平移：按住鼠标左键拖动图片"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• 双击重置：双击图片恢复初始状态"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• 工具栏操作：放大、缩小、旋转、适应窗口、重置"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,16"/>

                <TextBlock Style="{DynamicResource Mine.Typography.BodyLarge}"
                           Margin="0,8,0,12">
                    <Run Text="主要属性：" FontWeight="SemiBold"/>
                </TextBlock>
                <TextBlock Text="• Source：图片源（支持 URL 或本地路径）"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• ShowToolbar：是否显示工具栏"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• EnableZoom：启用缩放功能"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• EnablePan：启用拖拽功能"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• MinZoom / MaxZoom：缩放范围限制"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
                <TextBlock Text="• ZoomStep：每次缩放的步长"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"/>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
