<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.TabPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="TabControl / ListView"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <!-- ── TabControl ───────────────────────────────────────── -->
        <TextBlock Text="TabControl"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="0" Margin="0,0,0,32">
            <TabControl>
                <TabItem Header="Overview">
                    <StackPanel Margin="24">
                        <TextBlock Text="Overview Tab"
                                   Style="{DynamicResource Mine.Typography.TitleSmall}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="这是 TabControl 的 Overview 标签页内容。Material 3 Primary Tabs 使用下划线指示器标记当前选中项，颜色取自 Primary。"
                                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Features">
                    <StackPanel Margin="24">
                        <TextBlock Text="Features Tab"
                                   Style="{DynamicResource Mine.Typography.TitleSmall}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="可以包含任意内容控件。TabItem 的 Header 支持字符串和任意 UIElement（如包含图标的 StackPanel）。"
                                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Settings">
                    <StackPanel Margin="24">
                        <TextBlock Text="Settings Tab"
                                   Style="{DynamicResource Mine.Typography.TitleSmall}"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="第三个标签页。TabItem 禁用时透明度降至 38%。"
                                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </TabItem>
                <TabItem Header="Disabled" IsEnabled="False">
                    <TextBlock Text="Disabled" Margin="24"/>
                </TabItem>
            </TabControl>
        </mine:Card>

        <!-- ── ListBox ──────────────────────────────────────────── -->
        <TextBlock Text="ListBox"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="0" Margin="0,0,0,32">
            <ListBox x:Name="DemoListBox"
                     BorderThickness="0"
                     MaxHeight="280">
                <ListBoxItem Content="🔔  通知设置"/>
                <ListBoxItem Content="🎨  主题颜色"/>
                <ListBoxItem Content="🌐  语言与区域"/>
                <ListBoxItem Content="🔒  隐私与安全"/>
                <ListBoxItem Content="💾  存储管理"/>
                <ListBoxItem Content="🔧  高级设置" IsEnabled="False"/>
            </ListBox>
        </mine:Card>

        <!-- ── ListView (GridView) ──────────────────────────────── -->
        <TextBlock Text="ListView — GridView"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="0" Margin="0,0,0,24">
            <ListView x:Name="DemoListView"
                      BorderThickness="0"
                      MaxHeight="320">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称"     Width="200" DisplayMemberBinding="{Binding Name}"/>
                        <GridViewColumn Header="类型"     Width="120" DisplayMemberBinding="{Binding Type}"/>
                        <GridViewColumn Header="大小"     Width="100" DisplayMemberBinding="{Binding Size}"/>
                        <GridViewColumn Header="修改日期" Width="160" DisplayMemberBinding="{Binding Date}"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </mine:Card>

    </StackPanel>
</mine:Page>

