<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.ShieldPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls;assembly=Mine.Wpf.Controls"
           Title="Shield"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="1200">

        <!-- ── 基本用法 ──────────────────────────────────────────── -->
        <TextBlock Text="基本用法"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <TextBlock Text="展示标签和相应的值,具有典型的 Shield 外观。"
                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   Margin="0,0,0,16"/>

        <mine:Card Padding="20" Margin="0,0,0,32">
            <WrapPanel>
                <controls:Shield Label="Build" Value="Passing" Margin="0,0,8,8"/>
                <controls:Shield Label="Version" Value="v1.2.3" Color="{DynamicResource Mine.Brush.Secondary}" Margin="0,0,8,8"/>
                <controls:Shield Label="License" Value="MIT" Color="{DynamicResource Mine.Brush.Tertiary}" Margin="0,0,8,8"/>
            </WrapPanel>
        </mine:Card>

        <!-- ── 状态演示 ──────────────────────────────────────────── -->
        <TextBlock Text="状态演示"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <TextBlock Text="可以根据不同的含义手动设置右侧背景色。"
                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   Margin="0,0,0,16"/>

        <mine:Card Padding="20" Margin="0,0,0,32">
            <StackPanel Orientation="Horizontal">
                <controls:Shield Label="Coverage" Value="95%" Color="#FF4CAF50" Margin="0,0,8,0"/>
                <controls:Shield Label="Issues" Value="12 open" Color="#FFF44336" Margin="0,0,8,0"/>
                <controls:Shield Label="Downloads" Value="25k" Color="#FF2196F3" Margin="0,0,8,0"/>
            </StackPanel>
        </mine:Card>

        <!-- ── 样式定制 ──────────────────────────────────────────── -->
        <TextBlock Text="样式定制"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:Card Padding="20" Margin="0,0,0,32">
            <StackPanel Orientation="Horizontal">
                <controls:Shield Label="Square" Value="Style" CornerRadius="0" Margin="0,0,8,0"/>
                <controls:Shield Label="Rounded" Value="Full" CornerRadius="10" Margin="0,0,8,0"/>
                <controls:Shield Label="Custom" Value="Background" LabelBackground="#EEEEEE" Margin="0,0,8,0"/>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
