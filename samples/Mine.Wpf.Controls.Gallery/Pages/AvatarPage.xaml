<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.AvatarPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Avatar"
           Padding="28,24,28,32">
    <mine:Page.Resources>
        <DrawingImage x:Key="SampleAvatarImage.Warm">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFE7D9">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,96,96"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFF5B08C">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,38" RadiusX="24" RadiusY="24"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF6D4C41">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,116" RadiusX="38" RadiusY="42"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF5D4037">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,34" RadiusX="18" RadiusY="18"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="SampleAvatarImage.Cool">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFD7ECFF">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,96,96"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF9FD3FF">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,36" RadiusX="23" RadiusY="23"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF355C7D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,114" RadiusX="40" RadiusY="44"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FF27496D">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="48,34" RadiusX="16" RadiusY="16"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </mine:Page.Resources>
    <StackPanel MaxWidth="760">
            <TextBlock Text="Avatar"
                       Style="{DynamicResource Mine.Typography.HeadlineMedium}"
                       Margin="0,0,0,8"/>
            <TextBlock Text="A circular representation of a user, supporting image, icon, or initials."
                       Style="{DynamicResource Mine.Typography.BodyLarge}"
                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28"/>

            <!-- 默认（人形图标） -->
            <TextBlock Text="Default（无内容）"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <WrapPanel>
                    <mine:Avatar Size="32"  Margin="8"/>
                    <mine:Avatar Size="40"  Margin="8"/>
                    <mine:Avatar Size="56"  Margin="8"/>
                    <mine:Avatar Size="72"  Margin="8"/>
                    <mine:Avatar Size="96"  Margin="8"/>
                    <mine:Avatar Size="120" Margin="8"/>
                </WrapPanel>
            </mine:Card>

            <!-- Image -->
            <TextBlock Text="Image（图片头像）"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <WrapPanel>
                        <mine:Avatar Size="40" Margin="8"
                                     ImageSource="{StaticResource SampleAvatarImage.Warm}"/>
                        <mine:Avatar Size="56" Margin="8"
                                     ImageSource="{StaticResource SampleAvatarImage.Cool}"/>
                        <mine:Avatar Size="72" Margin="8"
                                     ImageSource="{StaticResource SampleAvatarImage.Warm}"/>
                        <mine:Avatar Size="96" Margin="8"
                                     ImageSource="{StaticResource SampleAvatarImage.Cool}"/>
                    </WrapPanel>
                    <TextBlock Text="Avatar 现在支持 ImageSource，图片会以 UniformToFill 方式铺满，并按圆形边缘真实裁剪。"
                               Style="{DynamicResource Mine.Typography.BodyMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               TextWrapping="Wrap"
                               Margin="8,12,8,0"/>
                </StackPanel>
            </mine:Card>

            <!-- Initials -->
            <TextBlock Text="Initials（文字头像）"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <WrapPanel>
                    <mine:Avatar Initials="A"  Size="40" Margin="8"/>
                    <mine:Avatar Initials="JD" Size="40" Margin="8"/>
                    <mine:Avatar Initials="李" Size="40" Margin="8"
                                 Background="{DynamicResource Mine.Brush.TertiaryContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnTertiaryContainer}"/>
                    <mine:Avatar Initials="王伟" Size="40" Margin="8"
                                 Background="{DynamicResource Mine.Brush.ErrorContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnErrorContainer}"/>
                    <mine:Avatar Initials="MK" Size="56" Margin="8"/>
                    <mine:Avatar Initials="Z"  Size="72" Margin="8"
                                 Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                </WrapPanel>
            </mine:Card>

            <!-- Icon -->
            <TextBlock Text="Icon（图标头像）"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <WrapPanel>
                    <mine:Avatar Icon="&#xE879;" Size="40" Margin="8"/>
                    <mine:Avatar Icon="&#xE7FE;" Size="40" Margin="8"
                                 Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                    <mine:Avatar Icon="&#xE853;" Size="40" Margin="8"
                                 Background="{DynamicResource Mine.Brush.TertiaryContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnTertiaryContainer}"/>
                    <mine:Avatar Icon="&#xE8D3;" Size="56" Margin="8"/>
                    <mine:Avatar Icon="&#xE90D;" Size="72" Margin="8"
                                 Background="{DynamicResource Mine.Brush.ErrorContainer}"
                                 Foreground="{DynamicResource Mine.Brush.OnErrorContainer}"/>
                </WrapPanel>
            </mine:Card>

            <!-- 自定义颜色 -->
            <TextBlock Text="自定义颜色"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <WrapPanel>
                    <mine:Avatar Initials="M3" Size="40" Margin="8"
                                 Background="#6750A4" Foreground="White"/>
                    <mine:Avatar Initials="WP" Size="40" Margin="8"
                                 Background="#0078D4" Foreground="White"/>
                    <mine:Avatar Initials="GG" Size="40" Margin="8"
                                 Background="#1A73E8" Foreground="White"/>
                    <mine:Avatar Icon="&#xE7EF;" Size="40" Margin="8"
                                 Background="#E8430D" Foreground="White"/>
                    <mine:Avatar Initials="YT" Size="40" Margin="8"
                                 Background="#FF0000" Foreground="White"/>
                </WrapPanel>
            </mine:Card>

            <!-- 与其他控件组合 -->
            <TextBlock Text="与其他控件组合"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <!-- 用户信息行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <mine:Avatar Initials="JD" Size="48" Margin="0,0,12,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="John Doe"
                                       Style="{DynamicResource Mine.Typography.TitleSmall}"/>
                            <TextBlock Text="john.doe@example.com"
                                       Style="{DynamicResource Mine.Typography.BodySmall}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <mine:Avatar Icon="&#xE7FE;" Size="48" Margin="0,0,12,0"
                                     Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                     Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Guest User"
                                       Style="{DynamicResource Mine.Typography.TitleSmall}"/>
                            <TextBlock Text="Not signed in"
                                       Style="{DynamicResource Mine.Typography.BodySmall}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Avatar + Badge 组合 -->
                    <TextBlock Text="带徽标"
                               Style="{DynamicResource Mine.Typography.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="0,8,0,8"/>
                    <WrapPanel>
                        <mine:Badge BadgeText="" Margin="8">
                            <mine:Avatar Initials="A" Size="48"/>
                        </mine:Badge>
                        <mine:Badge BadgeText="3" Margin="8">
                            <mine:Avatar Icon="&#xE7FE;" Size="48"
                                         Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                         Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                        </mine:Badge>
                        <mine:Badge BadgeText="New" Margin="8">
                            <mine:Avatar Size="48"/>
                        </mine:Badge>
                    </WrapPanel>
                </StackPanel>
            </mine:Card>

            <!-- ── AvatarGroup ────────────────────────────────────────── -->
            <TextBlock Text="AvatarGroup"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,12"/>
            <mine:Card Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <!-- 基础重叠 -->
                    <TextBlock Text="基础重叠（默认 MaxCount=5，Spacing=-8）"
                               Style="{DynamicResource Mine.Typography.LabelLarge}"
                               Foreground="{DynamicResource Mine.Brush.Primary}"
                               Margin="0,0,0,12"/>
                    <mine:AvatarGroup Margin="0,0,0,20">
                        <mine:Avatar Initials="JD"/>
                        <mine:Avatar Initials="李" Background="#6750A4" Foreground="White"/>
                        <mine:Avatar Icon="&#xE7FE;"
                                     Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                     Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                        <mine:Avatar Initials="WK" Background="#0078D4" Foreground="White"/>
                        <mine:Avatar Initials="MK" Background="{DynamicResource Mine.Brush.TertiaryContainer}"
                                     Foreground="{DynamicResource Mine.Brush.OnTertiaryContainer}"/>
                    </mine:AvatarGroup>

                    <!-- 溢出气泡 -->
                    <TextBlock Text="溢出气泡（MaxCount=4，共 7 个）"
                               Style="{DynamicResource Mine.Typography.LabelLarge}"
                               Foreground="{DynamicResource Mine.Brush.Primary}"
                               Margin="0,0,0,12"/>
                    <mine:AvatarGroup MaxCount="4" Margin="0,0,0,20">
                        <mine:Avatar Initials="A"  Background="#E53935" Foreground="White"/>
                        <mine:Avatar Initials="B"  Background="#8E24AA" Foreground="White"/>
                        <mine:Avatar Initials="C"  Background="#1E88E5" Foreground="White"/>
                        <mine:Avatar Initials="D"  Background="#00897B" Foreground="White"/>
                        <mine:Avatar Initials="E"  Background="#F4511E" Foreground="White"/>
                        <mine:Avatar Initials="F"  Background="#0B8043" Foreground="White"/>
                        <mine:Avatar Initials="G"  Background="#3949AB" Foreground="White"/>
                    </mine:AvatarGroup>

                    <!-- 大尺寸 / 宽间距 -->
                    <TextBlock Text="大尺寸（AvatarSize=56，Spacing=-12）"
                               Style="{DynamicResource Mine.Typography.LabelLarge}"
                               Foreground="{DynamicResource Mine.Brush.Primary}"
                               Margin="0,0,0,12"/>
                    <mine:AvatarGroup AvatarSize="56" Spacing="-12" Margin="0,0,0,20">
                        <mine:Avatar Initials="张" Background="#6750A4" Foreground="White"/>
                        <mine:Avatar Initials="李" Background="#E53935" Foreground="White"/>
                        <mine:Avatar Initials="王" Background="#0078D4" Foreground="White"/>
                        <mine:Avatar Icon="&#xE7FE;"
                                     Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                     Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                    </mine:AvatarGroup>

                    <!-- 与文字组合 -->
                    <TextBlock Text="与文字组合"
                               Style="{DynamicResource Mine.Typography.LabelLarge}"
                               Foreground="{DynamicResource Mine.Brush.Primary}"
                               Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <mine:AvatarGroup MaxCount="3" VerticalAlignment="Center">
                            <mine:Avatar Initials="JD"/>
                            <mine:Avatar Initials="李" Background="#6750A4" Foreground="White"/>
                            <mine:Avatar Icon="&#xE7FE;"
                                         Background="{DynamicResource Mine.Brush.PrimaryContainer}"
                                         Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                            <mine:Avatar Initials="WK" Background="#0078D4" Foreground="White"/>
                            <mine:Avatar Initials="MK"/>
                        </mine:AvatarGroup>
                        <TextBlock Text="5 名成员"
                                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </mine:Card>
    </StackPanel>
</mine:Page>