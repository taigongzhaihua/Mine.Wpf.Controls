<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.SideSheetPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Side Sheet"
           Padding="0"
           IsScrollable="False">

    <!--
        SideSheetPage：整个页面是一个 SideSheet 容器，
        从左或右侧滑入，支持 Modal / Standard 两种变体。
    -->
    <mine:SideSheet x:Name="DemoSheet"
                    Variant="Modal"
                    Placement="Right"
                    CloseOnScrimClick="True">

        <!-- Sheet 内容 -->
        <mine:SideSheet.SheetContent>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部 -->
                <Border Grid.Row="0"
                        Padding="24,20,24,16"
                        BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="SheetTitle"
                                   Grid.Column="0"
                                   Text="筛选条件"
                                   Style="{DynamicResource Mine.Typography.TitleLarge}"
                                   VerticalAlignment="Center"/>
                        <mine:Button Grid.Column="1"
                                     Style="{DynamicResource Mine.Style.Button.Icon}"
                                     Icon="&#xE5CD;"
                                     Click="OnCloseSheet"/>
                    </Grid>
                </Border>

                <!-- 内容区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
                    <StackPanel x:Name="SheetBody">
                        <TextBlock Text="分类"
                                   Style="{DynamicResource Mine.Typography.LabelMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   Margin="0,0,0,8"/>
                        <mine:Chip Content="设计" IsChecked="True" Margin="0,0,8,8"/>
                        <mine:Chip Content="开发" Margin="0,0,8,8"/>
                        <mine:Chip Content="产品" Margin="0,0,8,8"/>
                        <mine:Chip Content="运营" Margin="0,0,0,0"/>

                        <Separator Margin="0,16" Background="{DynamicResource Mine.Brush.OutlineVariant}"/>

                        <TextBlock Text="时间范围"
                                   Style="{DynamicResource Mine.Typography.LabelMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   Margin="0,0,0,8"/>
                        <mine:RadioButton Content="最近 7 天" IsChecked="True" Margin="0,0,0,4"/>
                        <mine:RadioButton Content="最近 30 天" Margin="0,0,0,4"/>
                        <mine:RadioButton Content="最近 3 个月" Margin="0,0,0,4"/>
                        <mine:RadioButton Content="自定义范围" Margin="0,0,0,0"/>

                        <Separator Margin="0,16" Background="{DynamicResource Mine.Brush.OutlineVariant}"/>

                        <TextBlock Text="状态"
                                   Style="{DynamicResource Mine.Typography.LabelMedium}"
                                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                   Margin="0,0,0,8"/>
                        <mine:CheckBox Content="进行中" IsChecked="True" Margin="0,0,0,4"/>
                        <mine:CheckBox Content="已完成" IsChecked="True" Margin="0,0,0,4"/>
                        <mine:CheckBox Content="已取消" Margin="0,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- 底部操作 -->
                <Border Grid.Row="2"
                        Padding="24,16"
                        BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                        BorderThickness="0,1,0,0">
                    <WrapPanel HorizontalAlignment="Right">
                        <mine:Button Content="重置"
                                     Style="{DynamicResource Mine.Style.Button.Outlined}"
                                     Margin="0,0,8,0"
                                     Click="OnCloseSheet"/>
                        <mine:Button Content="应用筛选"
                                     Click="OnCloseSheet"/>
                    </WrapPanel>
                </Border>
            </Grid>
        </mine:SideSheet.SheetContent>

        <!-- 主体内容 -->
        <Grid Background="{DynamicResource Mine.Brush.Background}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24,28,32" MaxWidth="760">

                    <TextBlock Text="Side Sheet"
                               Style="{DynamicResource Mine.Typography.HeadlineMedium}"
                               Margin="0,0,0,8"/>
                    <TextBlock Text="从左侧或右侧滑入的面板，用于展示与当前内容相关的详情、筛选条件或辅助操作。支持模态（Modal）与标准（Standard）两种变体。"
                               Style="{DynamicResource Mine.Typography.BodyLarge}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,28"/>

                    <!-- Modal 右侧 -->
                    <TextBlock Text="Modal Side Sheet — Right（右侧模态）"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="带遮罩，从右侧滑入，常用于详情面板、筛选条件。点击遮罩或关闭按钮关闭。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="筛选条件"
                                             Icon="&#xEF4F;"
                                             Margin="0,0,8,0"
                                             Click="OnOpenRightModal"/>
                                <mine:Button Content="详情面板"
                                             Style="{DynamicResource Mine.Style.Button.FilledTonal}"
                                             Icon="&#xE8EF;"
                                             Click="OnOpenDetail"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- Modal 左侧 -->
                    <TextBlock Text="Modal Side Sheet — Left（左侧模态）"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="带遮罩，从左侧滑入，常用于二级导航或上下文帮助。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="从左侧打开"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Icon="&#xE5D2;"
                                             Click="OnOpenLeftModal"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- Standard -->
                    <TextBlock Text="Standard Side Sheet（标准，无遮罩）"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="无遮罩，面板与主内容并排，适合宽屏布局下持续展示的辅助信息。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="打开 Standard Sheet"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Icon="&#xE5D2;"
                                             Click="OnOpenStandard"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- 宽度控制 -->
                    <TextBlock Text="自定义宽度"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="通过 SheetWidth 指定面板宽度，默认 360。"
                                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,16"/>
                            <WrapPanel>
                                <mine:Button Content="宽度 280"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Margin="0,0,8,0"
                                             Click="OnOpenWidth280"/>
                                <mine:Button Content="宽度 480"
                                             Style="{DynamicResource Mine.Style.Button.Outlined}"
                                             Click="OnOpenWidth480"/>
                            </WrapPanel>
                        </StackPanel>
                    </mine:Card>

                    <!-- 属性说明 -->
                    <TextBlock Text="主要属性"
                               Style="{DynamicResource Mine.Typography.TitleMedium}"
                               Margin="0,0,0,12"/>
                    <mine:Card Padding="24" Margin="0,0,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="IsOpen"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="bool — 控制面板开关"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Variant"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="Modal（有遮罩）/ Standard（无遮罩）"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Placement"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="Left / Right — 面板从哪一侧滑入"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="SheetWidth"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="double — 面板宽度，默认 360"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="CloseOnScrimClick"
                                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                                           Foreground="{DynamicResource Mine.Brush.Primary}"/>
                                <TextBlock Grid.Column="1" Text="bool — 点击遮罩是否自动关闭"
                                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                            </Grid>
                        </StackPanel>
                    </mine:Card>

                </StackPanel>
            </ScrollViewer>
        </Grid>

    </mine:SideSheet>
</mine:Page>
