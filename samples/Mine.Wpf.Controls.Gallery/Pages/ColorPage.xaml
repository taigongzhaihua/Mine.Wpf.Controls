<UserControl x:Class="Mine.Wpf.Controls.Gallery.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mine="https://schemas.mine.io/wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel MaxWidth="860" Margin="0,0,0,32">

        <!-- ── 当前主题信息横幅 ─────────────────────────────────── -->
        <mine:Card Padding="16,12" Margin="0,0,0,20"
                   Background="{DynamicResource Mine.Brush.PrimaryContainer}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 色块预览 -->
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                        Background="{DynamicResource Mine.Brush.Primary}" Margin="0,0,12,0"/>
                <!-- 文字 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ThemeLabel}"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.TitleSmall}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                    <TextBlock Text="{Binding SeedHex}"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                               Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"
                               Opacity="0.75"
                               Visibility="{Binding IsCustom, Converter={StaticResource Mine.Internal.BoolToVisConv}}"/>
                    <TextBlock Text="颜色由 XAML 资源字典提供，无运行时计算"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                               Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"
                               Opacity="0.75"
                               Visibility="{Binding IsPreset, Converter={StaticResource Mine.Internal.BoolToVisConv}}"/>
                </StackPanel>
                <!-- 徽章标签 -->
                <Border Grid.Column="2" CornerRadius="8" Padding="10,4"
                        Background="{DynamicResource Mine.Brush.Primary}">
                    <TextBlock FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.LabelSmall}"
                               Foreground="{DynamicResource Mine.Brush.OnPrimary}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PRESET"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustom}" Value="True">
                                        <Setter Property="Text" Value="CUSTOM SEED"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </mine:Card>

        <!-- ── 自定义模式：调色板预览 ─────────────────────────────── -->
        <StackPanel Visibility="{Binding IsCustom, Converter={StaticResource Mine.Internal.BoolToVisConv}}">
            <TextBlock Text="Tonal Palette（OKLCH 生成）"
                       Style="{DynamicResource Mine.Typography.TitleMedium}" Margin="0,0,0,8"/>
            <TextBlock Text="从种子色在 OKLCH 感知均匀色彩空间生成 21 个色调，Secondary/Tertiary 由色相旋转衍生"
                       FontFamily="{DynamicResource Mine.FontFamily.Default}"
                       FontSize="{DynamicResource Mine.FontSize.BodySmall}"
                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                       Margin="0,0,0,12" TextWrapping="Wrap"/>
            <mine:Card Padding="12" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Primary Palette"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding PrimaryTones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" Width="52" Height="52"
                                        CornerRadius="6" Margin="2">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Fg}"
                                               FontSize="9" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Mine.FontFamily.Default}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Secondary Palette"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="0,10,0,6"/>
                    <ItemsControl ItemsSource="{Binding SecondaryTones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" Width="52" Height="52"
                                        CornerRadius="6" Margin="2">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Fg}"
                                               FontSize="9" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Mine.FontFamily.Default}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Tertiary Palette"
                               FontFamily="{DynamicResource Mine.FontFamily.Default}"
                               FontSize="{DynamicResource Mine.FontSize.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="0,10,0,6"/>
                    <ItemsControl ItemsSource="{Binding TertiaryTones}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Bg}" Width="52" Height="52"
                                        CornerRadius="6" Margin="2">
                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Fg}"
                                               FontSize="9" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{DynamicResource Mine.FontFamily.Default}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </mine:Card>
        </StackPanel>

        <!-- ── Color Roles ────────────────────────────────────────── -->
        <TextBlock Text="Color Roles" Style="{DynamicResource Mine.Typography.TitleMedium}" Margin="0,12,0,8"/>

        <!-- Primary -->
        <TextBlock Text="Primary" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Primary}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Primary" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnPrimary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.OnPrimary}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="On Primary" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.Primary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.PrimaryContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Primary Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.OnPrimaryContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="On Primary Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.PrimaryContainer}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

        <!-- Secondary -->
        <TextBlock Text="Secondary" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Secondary}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Secondary" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSecondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.OnSecondary}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="On Secondary" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.Secondary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SecondaryContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Secondary Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.OnSecondaryContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="On Secondary Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

        <!-- Tertiary -->
        <TextBlock Text="Tertiary" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Tertiary}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Tertiary" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnTertiary}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.TertiaryContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Tertiary Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnTertiaryContainer}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

        <!-- Error -->
        <TextBlock Text="Error" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Error}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Error" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnError}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.ErrorContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Error Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnErrorContainer}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

        <!-- Surface -->
        <TextBlock Text="Surface" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,12">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Surface}"
                        BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Surface" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SurfaceContainerLowest}"
                        BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Container Lowest" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SurfaceContainerLow}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Container Low" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SurfaceContainer}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Container" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SurfaceContainerHigh}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Container High" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.SurfaceContainerHighest}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Container Highest" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

        <!-- Outline -->
        <TextBlock Text="Outline" Style="{DynamicResource Mine.Typography.LabelLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}" Margin="0,0,0,6"/>
        <mine:Card Padding="16" Margin="0,0,0,20">
            <WrapPanel>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.Outline}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Outline" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.Surface}"/>
                    </StackPanel>
                </Border>
                <Border CornerRadius="12" Width="150" Height="80" Margin="6" Background="{DynamicResource Mine.Brush.OutlineVariant}">
                    <StackPanel VerticalAlignment="Bottom" Margin="10,0,10,10">
                        <TextBlock Text="Outline Variant" FontFamily="{DynamicResource Mine.FontFamily.Default}" FontSize="11" Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </mine:Card>

    </StackPanel>
    </ScrollViewer>
</UserControl>

