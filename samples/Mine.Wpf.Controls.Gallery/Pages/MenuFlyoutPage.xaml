<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.MenuFlyoutPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="MenuFlyout"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <!-- ── 基础菜单 ─────────────────────────────────────────────── -->
        <TextBlock Text="基础菜单"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <mine:Button Content="打开菜单"
                             Variant="Filled"
                             Click="OnOpenMenuClick"/>

                <mine:MenuFlyout x:Name="StandaloneMenu">
                    <mine:MenuFlyout.Items>
                        <mine:MenuFlyoutItem Text="新建" InputGestureText="Ctrl+N">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="Add" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutItem Text="打开" InputGestureText="Ctrl+O">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="FolderOpen" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutItem Text="保存" InputGestureText="Ctrl+S">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="Save" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutSeparator/>
                        <mine:MenuFlyoutItem Text="退出" InputGestureText="Alt+F4">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="Close" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                    </mine:MenuFlyout.Items>
                </mine:MenuFlyout>
            </StackPanel>
        </mine:Card>

        <!-- ── 带子菜单 ─────────────────────────────────────────────── -->
        <TextBlock Text="带子菜单"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <mine:Button Content="打开菜单"
                             Variant="Filled"
                             Click="OnOpenSubMenuClick"/>

                <mine:MenuFlyout x:Name="SubMenuFlyout">
                    <mine:MenuFlyout.Items>
                        <mine:MenuFlyoutItem Text="复制">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="ContentCopy" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutItem Text="粘贴">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="ContentPaste" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutSeparator/>
                        <mine:MenuFlyoutSubItem Text="导出">
                            <mine:MenuFlyoutSubItem.Icon>
                                <mine:MaterialIcon Kind="FileDownload" Size="20"/>
                            </mine:MenuFlyoutSubItem.Icon>
                            <mine:MenuFlyoutSubItem.Items>
                                <mine:MenuFlyoutItem Text="导出为 PDF"/>
                                <mine:MenuFlyoutItem Text="导出为 PNG"/>
                                <mine:MenuFlyoutItem Text="导出为 SVG"/>
                            </mine:MenuFlyoutSubItem.Items>
                        </mine:MenuFlyoutSubItem>
                        <mine:MenuFlyoutSubItem Text="导入">
                            <mine:MenuFlyoutSubItem.Icon>
                                <mine:MaterialIcon Kind="FileUpload" Size="20"/>
                            </mine:MenuFlyoutSubItem.Icon>
                            <mine:MenuFlyoutSubItem.Items>
                                <mine:MenuFlyoutItem Text="从文件导入"/>
                                <mine:MenuFlyoutItem Text="从剪贴板导入"/>
                            </mine:MenuFlyoutSubItem.Items>
                        </mine:MenuFlyoutSubItem>
                    </mine:MenuFlyout.Items>
                </mine:MenuFlyout>
            </StackPanel>
        </mine:Card>

        <!-- ── 菜单项状态 ───────────────────────────────────────────── -->
        <TextBlock Text="菜单项状态"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <mine:Button Content="打开菜单"
                             Variant="Filled"
                             Click="OnOpenStatesMenuClick"/>

                <mine:MenuFlyout x:Name="StatesMenu">
                    <mine:MenuFlyout.Items>
                        <mine:MenuFlyoutItem Text="正常项"/>
                        <mine:MenuFlyoutItem Text="禁用项" IsEnabled="False"/>
                        <mine:MenuFlyoutItem Text="带图标（禁用）" IsEnabled="False">
                            <mine:MenuFlyoutItem.Icon>
                                <mine:MaterialIcon Kind="Star" Size="20"/>
                            </mine:MenuFlyoutItem.Icon>
                        </mine:MenuFlyoutItem>
                        <mine:MenuFlyoutSeparator/>
                        <mine:MenuFlyoutItem Text="另一个正常项"/>
                    </mine:MenuFlyout.Items>
                </mine:MenuFlyout>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
