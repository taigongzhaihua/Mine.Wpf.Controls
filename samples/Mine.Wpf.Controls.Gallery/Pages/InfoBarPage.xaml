<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.InfoBarPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="InfoBar"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <TextBlock Text="InfoBar"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <TextBlock Text="内联信息提示条，常驻于布局中，不自动消失，支持四种语义级别。"
                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   Margin="0,0,0,16"/>

        <mine:InfoBar Severity="Info"
                      Title="提示"
                      Message="这是一条普通信息提示，用于展示中性状态说明。"
                      Margin="0,0,0,12"/>

        <mine:InfoBar Severity="Success"
                      Title="操作成功"
                      Message="您的更改已成功保存。"
                      Margin="0,0,0,12"/>

        <mine:InfoBar Severity="Warning"
                      Title="需要注意"
                      Message="磁盘空间不足，建议清理后再继续。"
                      Margin="0,0,0,12"/>

        <mine:InfoBar Severity="Error"
                      Title="操作失败"
                      Message="网络连接已断开，请检查网络设置后重试。"
                      Margin="0,0,0,24"/>

        <!-- ── 带操作按钮 ─────────────────────────────────────────── -->
        <TextBlock Text="带操作按钮"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:InfoBar Severity="Warning"
                      Title="有可用更新"
                      Message="发现新版本 2.1.0，建议立即更新。"
                      Margin="0,0,0,24">
            <mine:InfoBar.ActionContent>
                <mine:Button Content="立即更新"
                            Style="{DynamicResource Mine.Style.Button.Text}"/>
            </mine:InfoBar.ActionContent>
        </mine:InfoBar>

        <!-- ── 不可关闭 ───────────────────────────────────────────── -->
        <TextBlock Text="不可关闭"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:InfoBar Severity="Info"
                      Title="系统通知"
                      Message="此提示无法被用户关闭。"
                      IsClosable="False"
                      Margin="0,0,0,24"/>

        <!-- ── 可关闭（触发 IsOpen） ─────────────────────────────── -->
        <TextBlock Text="可关闭"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:InfoBar x:Name="ClosableBar"
                      Severity="Success"
                      Title="欢迎使用"
                      Message="点击右上角关闭按钮可隐藏此提示。"
                      Margin="0,0,0,12"/>

        <mine:Button Content="重新显示"
                    Click="OnResetClosableBar"
                    Style="{DynamicResource Mine.Style.Button.Outlined}"
                    HorizontalAlignment="Left"/>

    </StackPanel>
</mine:Page>
