<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.GlassCardPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           xmlns:controls="clr-namespace:Mine.Wpf.Controls.Controls;assembly=Mine.Wpf.Controls"
           Title="GlassCard"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="1200">

        <!-- ── 基本用法 ──────────────────────────────────────────── -->
        <TextBlock Text="基本用法"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <TextBlock Text="半透明磨砂玻璃卡片，使用色彩叠加 + 噪点纹理模拟玻璃质感。"
                   Style="{DynamicResource Mine.Typography.BodyMedium}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   Margin="0,0,0,16"/>

        <!-- 背景演示区 -->
        <Border Height="400" 
                CornerRadius="12" 
                Margin="0,0,0,32"
                ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#667EEA" Offset="0"/>
                    <GradientStop Color="#764BA2" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <!-- 装饰性背景元素 -->
                <Ellipse Width="200" Height="200" 
                         Fill="#40FFFFFF" 
                         HorizontalAlignment="Left" 
                         VerticalAlignment="Top"
                         Margin="-50,-50,0,0"/>
                <Ellipse Width="150" Height="150" 
                         Fill="#30FFFFFF" 
                         HorizontalAlignment="Right" 
                         VerticalAlignment="Bottom"
                         Margin="0,0,-30,-30"/>

                <!-- GlassCard 示例 -->
                <StackPanel HorizontalAlignment="Center" 
                            VerticalAlignment="Center">

                    <controls:GlassCard Width="300" Height="150"
                                       TintOpacity="0.85"
                                       Margin="0,0,0,20">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="默认效果"
                                      FontSize="20"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="TintOpacity = 0.85"
                                      FontSize="14"
                                      Opacity="0.7"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:GlassCard>

                    <controls:GlassCard Width="300" Height="150"
                                       TintOpacity="0.6"
                                       TintColor="#80FFFFFF">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="更透明 + 浅色叠加"
                                      FontSize="20"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,8"/>
                            <TextBlock Text="TintOpacity = 0.6"
                                      FontSize="14"
                                      Opacity="0.7"
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </controls:GlassCard>

                </StackPanel>
            </Grid>
        </Border>

        <!-- ── 属性演示 ──────────────────────────────────────────── -->
        <TextBlock Text="属性调整"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:Card Padding="20" Margin="0,0,0,32">
            <StackPanel>
                <TextBlock Text="色彩叠加不透明度" 
                          Style="{DynamicResource Mine.Typography.LabelMedium}"
                          Margin="0,0,0,8"/>
                <Slider x:Name="OpacitySlider" 
                        Minimum="0" Maximum="1" Value="0.85"
                        Margin="0,0,0,16"/>

                <Border Height="200" 
                        Background="#9C27B0" 
                        CornerRadius="8"
                        ClipToBounds="True">
                    <controls:GlassCard Width="250" Height="120"
                                       TintOpacity="{Binding Value, ElementName=OpacitySlider}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="实时调整"
                                      FontSize="18"
                                      FontWeight="SemiBold"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,0,4"/>
                            <TextBlock HorizontalAlignment="Center">
                                <Run Text="不透明度:"/>
                                <Run Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:F2}}"/>
                            </TextBlock>
                        </StackPanel>
                    </controls:GlassCard>
                </Border>
            </StackPanel>
        </mine:Card>

        <!-- ── 技术说明 ──────────────────────────────────────────── -->
        <TextBlock Text="技术特性"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>

        <mine:Card Padding="20">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" 
                          Style="{DynamicResource Mine.Typography.BodyMedium}">
                    <Run Text="• 半透明质感："/>
                    <Run Text="通过色彩叠加和噪点纹理模拟磨砂玻璃效果。"
                         Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                          Style="{DynamicResource Mine.Typography.BodyMedium}"
                          Margin="0,8,0,0">
                    <Run Text="• 轻量实现："/>
                    <Run Text="纯 WPF 视觉层渲染，无外部依赖，支持所有 .NET 平台。"
                         Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                          Style="{DynamicResource Mine.Typography.BodyMedium}"
                          Margin="0,8,0,0">
                    <Run Text="• 圆角裁剪："/>
                    <Run Text="使用 RoundedRectClipConverter 确保内容严格遵守 CornerRadius。"
                         Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                          Style="{DynamicResource Mine.Typography.BodyMedium}"
                          Margin="0,8,0,0">
                    <Run Text="• 灵活定制："/>
                    <Run Text="支持调整 TintColor 和 TintOpacity 实现不同玻璃风格。"
                         Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
