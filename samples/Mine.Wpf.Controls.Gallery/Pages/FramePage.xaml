<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.FramePage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Frame / Page"
           IsScrollable="False"
           Padding="28,24,28,32">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── 控制区 ───────────────────────────────────────────────── -->
        <StackPanel Grid.Row="0">

            <TextBlock Text="Frame / Page 导航"
                       Style="{DynamicResource Mine.Typography.TitleMedium}"
                       Margin="0,0,0,4"/>
            <TextBlock Text="mine:Frame 管理导航栈，支持 Back / Forward 历史与过渡动画。mine:Page 是内容单元，可携带 Title、Subtitle 并感知导航生命周期。"
                       Style="{DynamicResource Mine.Typography.BodyMedium}"
                       Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <mine:Card Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 后退 / 前进 -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                        <mine:Button x:Name="BtnBack"
                                     Style="{DynamicResource Mine.Style.Button.Outlined}"
                                     Padding="12,0" Height="36" Margin="0,0,8,0"
                                     IsEnabled="{Binding CanGoBack, ElementName=DemoFrame}"
                                     Click="OnGoBack">
                            <mine:Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <mine:MaterialIcon Kind="&#xE5C4;" Size="18" Margin="0,0,4,0"/>
                                    <TextBlock Text="后退" VerticalAlignment="Center"/>
                                </StackPanel>
                            </mine:Button.Content>
                        </mine:Button>
                        <mine:Button x:Name="BtnForward"
                                     Style="{DynamicResource Mine.Style.Button.Outlined}"
                                     Padding="12,0" Height="36"
                                     IsEnabled="{Binding CanGoForward, ElementName=DemoFrame}"
                                     Click="OnGoForward">
                            <mine:Button.Content>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="前进" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <mine:MaterialIcon Kind="&#xE5C8;" Size="18"/>
                                </StackPanel>
                            </mine:Button.Content>
                        </mine:Button>
                    </StackPanel>

                    <!-- 页面选择 -->
                    <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <mine:Button Content="Page 1" Margin="0,0,8,0" Height="36"
                                     Padding="16,0" Click="OnNavigatePage1"
                                     Style="{DynamicResource Mine.Style.Button.FilledTonal}"/>
                        <mine:Button Content="Page 2" Margin="0,0,8,0" Height="36"
                                     Padding="16,0" Click="OnNavigatePage2"
                                     Style="{DynamicResource Mine.Style.Button.FilledTonal}"/>
                        <mine:Button Content="Page 3" Margin="0,0,8,0" Height="36"
                                     Padding="16,0" Click="OnNavigatePage3"
                                     Style="{DynamicResource Mine.Style.Button.FilledTonal}"/>
                        <mine:Button Content="清空历史" Height="36" Margin="0,0,8,0"
                                     Padding="16,0" Click="OnNavigateRoot"
                                     Style="{DynamicResource Mine.Style.Button.Outlined}"/>
                    </WrapPanel>

                    <!-- 过渡选择 -->
                    <mine:ComboBox Grid.Column="2"
                                   x:Name="TransitionPicker"
                                   Style="{DynamicResource Mine.Style.ComboBox.Outlined}"
                                   Margin="0,0,0,0"
                                   VerticalAlignment="Center"
                                   Hint="过渡"
                                   SelectedIndex="0"/>
                    
                </Grid>
            </mine:Card>

            <!-- 导航栈状态 -->
            <mine:Card Padding="16,12" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal">
                    <mine:MaterialIcon Kind="&#xE88A;" Size="18" Margin="0,0,8,0"
                                       Foreground="{DynamicResource Mine.Brush.Primary}"/>
                    <TextBlock Style="{DynamicResource Mine.Typography.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}">
                        <Run Text="后退栈："/>
                        <Run x:Name="RunBack" Text="空" FontWeight="Medium"
                             Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                        <Run Text="   前进栈："/>
                        <Run x:Name="RunForward" Text="空" FontWeight="Medium"
                             Foreground="{DynamicResource Mine.Brush.OnSurface}"/>
                        <Run Text="   当前页："/>
                        <Run x:Name="RunCurrent" Text="—" FontWeight="Medium"
                             Foreground="{DynamicResource Mine.Brush.Primary}"/>
                    </TextBlock>
                </StackPanel>
            </mine:Card>
        </StackPanel>

        <!-- ── Demo Frame ─────────────────���──────────────────────────── -->
        <Border Grid.Row="1"
                CornerRadius="12"
                BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                BorderThickness="1"
                ClipToBounds="True">
            <mine:Frame x:Name="DemoFrame"
                        Navigated="DemoFrame_Navigated"/>
        </Border>
    </Grid>
</mine:Page>

