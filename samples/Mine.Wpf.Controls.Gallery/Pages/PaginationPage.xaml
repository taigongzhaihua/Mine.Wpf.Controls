<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.PaginationPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Pagination"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <!-- ── 基本用法 ─────────────────────────────────────── -->
        <TextBlock Text="基本分页"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="默认样式" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,16"/>

                <mine:PaginationControl x:Name="BasicPagination"
                                       CurrentPage="1"
                                       TotalPages="10"
                                       HorizontalAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center">
                    <Run Text="当前页: "/>
                    <Run Text="{Binding CurrentPage, ElementName=BasicPagination, Mode=OneWay}"
                         Foreground="{DynamicResource Mine.Brush.Primary}"
                         FontWeight="SemiBold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, ElementName=BasicPagination, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <!-- ── 大量页面 ─────────────────────────────────────── -->
        <TextBlock Text="大量页面"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="自动显示省略号" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,16"/>

                <mine:PaginationControl x:Name="ManyPagesPagination"
                                       CurrentPage="25"
                                       TotalPages="100"
                                       MaxPageButtons="7"
                                       HorizontalAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center">
                    <Run Text="当前页: "/>
                    <Run Text="{Binding CurrentPage, ElementName=ManyPagesPagination, Mode=OneWay}"
                         Foreground="{DynamicResource Mine.Brush.Primary}"
                         FontWeight="SemiBold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, ElementName=ManyPagesPagination, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <!-- ── 少量页面 ─────────────────────────────────────── -->
        <TextBlock Text="少量页面"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="显示所有页码" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,16"/>

                <mine:PaginationControl x:Name="FewPagesPagination"
                                       CurrentPage="2"
                                       TotalPages="5"
                                       HorizontalAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center">
                    <Run Text="当前页: "/>
                    <Run Text="{Binding CurrentPage, ElementName=FewPagesPagination, Mode=OneWay}"
                         Foreground="{DynamicResource Mine.Brush.Primary}"
                         FontWeight="SemiBold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, ElementName=FewPagesPagination, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <!-- ── 隐藏首页/末页按钮 ─────────────────────────────────────── -->
        <TextBlock Text="简化样式"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="不显示首页和末页按钮" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,16"/>

                <mine:PaginationControl x:Name="SimplePagination"
                                       CurrentPage="5"
                                       TotalPages="20"
                                       ShowFirstLastButtons="False"
                                       HorizontalAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center">
                    <Run Text="当前页: "/>
                    <Run Text="{Binding CurrentPage, ElementName=SimplePagination, Mode=OneWay}"
                         Foreground="{DynamicResource Mine.Brush.Primary}"
                         FontWeight="SemiBold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, ElementName=SimplePagination, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <!-- ── 自定义页码按钮数量 ─────────────────────────────────────── -->
        <TextBlock Text="自定义配置"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="显示更多页码按钮" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,16"/>

                <mine:PaginationControl x:Name="CustomPagination"
                                       CurrentPage="15"
                                       TotalPages="50"
                                       MaxPageButtons="11"
                                       HorizontalAlignment="Center"/>

                <TextBlock Margin="0,16,0,0"
                           HorizontalAlignment="Center">
                    <Run Text="当前页: "/>
                    <Run Text="{Binding CurrentPage, ElementName=CustomPagination, Mode=OneWay}"
                         Foreground="{DynamicResource Mine.Brush.Primary}"
                         FontWeight="SemiBold"/>
                    <Run Text=" / "/>
                    <Run Text="{Binding TotalPages, ElementName=CustomPagination, Mode=OneWay}"/>
                    <Run Text="  (MaxPageButtons: 11)"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <!-- ── 使用说明 ─────────────────────────────────────── -->
        <TextBlock Text="使用方法"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24">
            <StackPanel>
                <TextBlock Text="基本属性" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,0,0,12"/>

                <TextBlock TextWrapping="Wrap" 
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                           Margin="0,0,0,8">
                    • <Bold>CurrentPage</Bold>: 当前页码 (从 1 开始)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                           Margin="0,0,0,8">
                    • <Bold>TotalPages</Bold>: 总页数
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                           Margin="0,0,0,8">
                    • <Bold>MaxPageButtons</Bold>: 最多显示的页码按钮数量 (默认: 7)
                </TextBlock>
                <TextBlock TextWrapping="Wrap" 
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                           Margin="0,0,0,16">
                    • <Bold>ShowFirstLastButtons</Bold>: 是否显示首页/末页按钮 (默认: True)
                </TextBlock>

                <Separator Margin="0,8" Background="{DynamicResource Mine.Brush.OutlineVariant}"/>

                <TextBlock Text="示例代码" 
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" 
                           Margin="0,16,0,12"/>

                <Border Background="{DynamicResource Mine.Brush.SurfaceContainerHighest}"
                        CornerRadius="8"
                        Padding="16">
                    <TextBlock FontFamily="Consolas" 
                               FontSize="12"
                               TextWrapping="Wrap"
                               xml:space="preserve"><![CDATA[<mine:PaginationControl CurrentPage="1"
                       TotalPages="10"
                       MaxPageButtons="7"
                       ShowFirstLastButtons="True"
                       PageChanged="OnPageChanged"/>]]></TextBlock>
                </Border>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
