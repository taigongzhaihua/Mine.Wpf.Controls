<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.DatePickerPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="DatePicker"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="760">
        <TextBlock Text="DatePicker"
                   Style="{DynamicResource Mine.Typography.HeadlineMedium}"
                   Margin="0,0,0,8"/>
        <TextBlock Text="Material Design 3 风格日期选择器，默认 Outlined 外观，支持 Filled 变体、单日期和日期范围选择。"
                   Style="{DynamicResource Mine.Typography.BodyLarge}"
                   Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,20"/>

        <mine:Card Padding="24" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="外观变体"
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:DatePicker x:Name="BasicDatePicker"
                                     Hint="Outlined（默认）"
                                     HelperText="请选择一个日期"
                                     Width="240"
                                     Margin="0,0,16,16"/>
                    <mine:DatePicker Hint="Filled"
                                     Variant="Filled"
                                     SelectedDate="2026-05-28"
                                     Width="240"
                                     Margin="0,0,16,16"/>
                    <mine:DatePicker Hint="禁用"
                                     SelectedDate="2026-05-28"
                                     Width="240"
                                     IsEnabled="False"
                                     Margin="0,0,16,16"/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}">
                    <Run Text="当前选择："/>
                    <Run Text="{Binding ElementName=BasicDatePicker, Path=SelectedDate, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='未选择'}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <mine:Card Padding="24" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="日期范围模式"
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:DatePicker x:Name="RangeDatePicker"
                                     SelectionMode="Range"
                                     Hint="旅行日期"
                                     HelperText="先选开始日期，再选结束日期"
                                     StartDate="2026-05-08"
                                     EndDate="2026-05-18"
                                     Width="320"
                                     Margin="0,0,16,16"/>
                    <mine:DatePicker SelectionMode="Range"
                                     Variant="Filled"
                                     Hint="限制范围"
                                     HelperText="仅可选择 2026 年"
                                     MinimumDate="2026-01-01"
                                     MaximumDate="2026-12-31"
                                     Width="320"
                                     Margin="0,0,16,16"/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0"
                           Style="{DynamicResource Mine.Typography.BodyMedium}"
                           Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}">
                    <Run Text="范围："/>
                    <Run Text="{Binding ElementName=RangeDatePicker, Path=StartDate, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='未选择'}"/>
                    <Run Text=" 至 "/>
                    <Run Text="{Binding ElementName=RangeDatePicker, Path=EndDate, StringFormat='{}{0:yyyy-MM-dd}', TargetNullValue='未选择'}"/>
                </TextBlock>
            </StackPanel>
        </mine:Card>

        <mine:Card Padding="24">
            <StackPanel>
                <TextBlock Text="格式与日历规则"
                           Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}"
                           Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:DatePicker Hint="中文格式"
                                     DisplayFormat="yyyy年MM月dd日"
                                     SelectedDate="2026-05-28"
                                     Width="260"
                                     Margin="0,0,16,16"/>
                    <mine:DatePicker Hint="周日开头"
                                     FirstDayOfWeek="Sunday"
                                     Width="240"
                                     Margin="0,0,16,16"/>
                </WrapPanel>
            </StackPanel>
        </mine:Card>
    </StackPanel>
</mine:Page>

