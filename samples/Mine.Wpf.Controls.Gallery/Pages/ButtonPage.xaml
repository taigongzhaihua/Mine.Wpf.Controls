<mine:Page x:Class="Mine.Wpf.Controls.Gallery.Pages.ButtonPage"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:mine="https://schemas.mine.io/wpf"
           Title="Button"
           Padding="28,24,28,32">
    <StackPanel MaxWidth="860">

        <!-- ── Button Variants ─────────────────────────────────────── -->
        <TextBlock Text="Button Variants"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="标准变体" Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:Button Content="Filled"    Variant="Filled"   Margin="0,0,8,8"/>
                    <mine:Button Content="Tonal"     Variant="Tonal"    Margin="0,0,8,8"/>
                    <mine:Button Content="Outlined"  Variant="Outlined" Margin="0,0,8,8"/>
                    <mine:Button Content="Text"      Variant="Text"     Margin="0,0,8,8"/>
                    <mine:Button Content="Elevated"  Variant="Elevated" Margin="0,0,8,8"/>
                </WrapPanel>

                <Separator Margin="0,16" Background="{DynamicResource Mine.Brush.OutlineVariant}"/>

                <TextBlock Text="状态" Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:Button Content="正在加载…" Variant="Filled"   IsLoading="True"    Margin="0,0,8,8"/>
                    <mine:Button Content="已禁用"    Variant="Filled"   IsEnabled="False"   Margin="0,0,8,8"/>
                    <mine:Button Content="已禁用"    Variant="Outlined" IsEnabled="False"   Margin="0,0,8,8"/>
                    <mine:Button Content="已禁用"    Variant="Text"     IsEnabled="False"   Margin="0,0,8,8"/>
                </WrapPanel>
            </StackPanel>
        </mine:Card>

        <!-- ── Icon Button ────────────────────────────────────────── -->
        <TextBlock Text="带图标的按钮"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Filled + Icon" Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" Margin="0,0,0,12"/>
                <WrapPanel>
                    <mine:Button Content="新建文档" Variant="Filled" Margin="0,0,8,8">
                        <mine:Button.Icon>
                            <mine:MaterialIcon Kind="Add" Size="18"
                                              Foreground="{DynamicResource Mine.Brush.OnPrimary}"/>
                        </mine:Button.Icon>
                    </mine:Button>
                    <mine:Button Content="上传" Variant="Tonal" Margin="0,0,8,8">
                        <mine:Button.Icon>
                            <mine:MaterialIcon Kind="FileUpload" Size="18"
                                              Foreground="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
                        </mine:Button.Icon>
                    </mine:Button>
                    <mine:Button Content="删除" Variant="Outlined" Margin="0,0,8,8">
                        <mine:Button.Icon>
                            <mine:MaterialIcon Kind="Delete" Size="18"
                                              Foreground="{DynamicResource Mine.Brush.Primary}"/>
                        </mine:Button.Icon>
                    </mine:Button>
                </WrapPanel>
            </StackPanel>
        </mine:Card>

        <!-- ── FAB ────────────────────────────────────────────────── -->
        <TextBlock Text="Floating Action Button"
                   Style="{DynamicResource Mine.Typography.TitleMedium}"
                   Margin="0,0,0,12"/>
        <mine:Card Padding="24" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="FAB 变体" Style="{DynamicResource Mine.Typography.LabelLarge}"
                           Foreground="{DynamicResource Mine.Brush.Primary}" Margin="0,0,0,16"/>
                <WrapPanel VerticalAlignment="Center">
                    <mine:Button Variant="Fab" Margin="0,0,16,0" ToolTip="FAB">
                        <mine:Button.Icon>
                            <mine:MaterialIcon Kind="Add" Size="24"
                                              Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                        </mine:Button.Icon>
                    </mine:Button>
                    <mine:Button Variant="ExtendedFab" Content="新建文档" Margin="0,0,16,0">
                        <mine:Button.Icon>
                            <mine:MaterialIcon Kind="Add" Size="20"
                                              Foreground="{DynamicResource Mine.Brush.OnPrimaryContainer}"/>
                        </mine:Button.Icon>
                    </mine:Button>
                </WrapPanel>
            </StackPanel>
        </mine:Card>

    </StackPanel>
</mine:Page>
