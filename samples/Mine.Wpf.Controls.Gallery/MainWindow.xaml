<mine:Window
    x:Class="Mine.Wpf.Controls.Gallery.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mine="https://schemas.mine.io/wpf"
    xmlns:local="clr-namespace:Mine.Wpf.Controls.Gallery"
    xmlns:pages="clr-namespace:Mine.Wpf.Controls.Gallery.Pages"
    Title="Mine Controls Gallery"
    Width="1200" Height="760"
    MinWidth="900" MinHeight="560"
    BackdropType="Mica"
    WindowStartupLocation="CenterScreen">

    <mine:Window.Resources>
        <!-- Nav item style -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"           Value="16,10"/>
            <Setter Property="Margin"            Value="8,2"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="FontFamily"        Value="{DynamicResource Mine.FontFamily.Default}"/>
            <Setter Property="FontSize"          Value="{DynamicResource Mine.FontSize.LabelLarge}"/>
            <Setter Property="Foreground"        Value="{DynamicResource Mine.Brush.OnSurfaceVariant}"/>
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="FocusVisualStyle"  Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="24"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon"
                                           Text="{Binding Icon}"
                                           FontSize="20"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{Binding Label}"
                                           VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Mine.Brush.SurfaceContainerHigh}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{DynamicResource Mine.Brush.SecondaryContainer}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Mine.Brush.OnSecondaryContainer}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Seed color button style -->
        <Style x:Key="SeedButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="28"/>
            <Setter Property="Height"          Value="28"/>
            <Setter Property="Margin"          Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Width="28" Height="28">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                            </Border.Effect>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </mine:Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ── Navigation Drawer ──────────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource Mine.Brush.SurfaceContainerLow}"
                BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- App title -->
                <StackPanel DockPanel.Dock="Top" Margin="24,20,24,12">
                    <TextBlock Text="Mine Controls"
                               Style="{DynamicResource Mine.Typography.TitleLarge}"/>
                    <TextBlock Text="Component Gallery"
                               Style="{DynamicResource Mine.Typography.LabelMedium}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Theme / Seed controls -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,20">
                    <Separator Margin="0,0,0,12"
                               Background="{DynamicResource Mine.Brush.OutlineVariant}"/>
                    <Button Content="切换 Light / Dark"
                            Style="{DynamicResource {x:Type Button}}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="OnToggleTheme"/>
                    <TextBlock Text="主题色"
                               Style="{DynamicResource Mine.Typography.LabelSmall}"
                               Foreground="{DynamicResource Mine.Brush.OnSurfaceVariant}"
                               Margin="4,0,0,6"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#6750A4" Tag="#6750A4" Click="OnSeedColor" ToolTip="Purple"/>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#006C4E" Tag="#006C4E" Click="OnSeedColor" ToolTip="Green"/>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#005FAF" Tag="#005FAF" Click="OnSeedColor" ToolTip="Blue"/>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#B5270F" Tag="#B5270F" Click="OnSeedColor" ToolTip="Red"/>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#7B5800" Tag="#7B5800" Click="OnSeedColor" ToolTip="Orange"/>
                        <Button Style="{StaticResource SeedButtonStyle}"
                                Background="#006874" Tag="#006874" Click="OnSeedColor" ToolTip="Teal"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Nav list -->
                <ListBox x:Name="NavList"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         BorderThickness="0"
                         Background="Transparent"
                         Margin="0,8,0,0"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Items>
                        <local:NavItem Label="Button"     Icon="⬡" PageType="{x:Type pages:ButtonPage}"/>
                        <local:NavItem Label="Text Field" Icon="✎" PageType="{x:Type pages:TextFieldPage}"/>
                        <local:NavItem Label="Selection"  Icon="✓" PageType="{x:Type pages:SelectionPage}"/>
                        <local:NavItem Label="Card"       Icon="▭" PageType="{x:Type pages:CardPage}"/>
                        <local:NavItem Label="Typography" Icon="A" PageType="{x:Type pages:TypographyPage}"/>
                        <local:NavItem Label="Color"      Icon="◉" PageType="{x:Type pages:ColorPage}"/>
                    </ListBox.Items>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ── Content Area ───────────────────────────────────────── -->
        <Grid Grid.Column="1" Background="{DynamicResource Mine.Brush.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0"
                    BorderBrush="{DynamicResource Mine.Brush.OutlineVariant}"
                    BorderThickness="0,0,0,1"
                    Padding="28,14">
                <TextBlock x:Name="PageTitle"
                           Style="{DynamicResource Mine.Typography.TitleLarge}"/>
            </Border>

            <!-- Page content -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ContentArea" Margin="28,24,28,32"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</mine:Window>

